<!-- ===================== SAMPUL / AMPLOP: "SEALED LETTER" ===================== -->
<div id="cover" aria-label="Sampul undangan">
  <div class="ambient-floral-canvas" aria-hidden="true"></div>
  <div class="sky" id="sky" aria-hidden="true"></div>
  <div class="petals in-cover" id="petalsCover" aria-hidden="true"></div>
  <div class="sparkles" data-sparkles="16" aria-hidden="true"></div>
  <div data-rings="" aria-hidden="true"></div>
  <div data-garland="tl tr bl br" data-gs="lg" aria-hidden="true"></div>

  <div class="c-inner">
    <div class="c-head">
      <p class="eyebrow-ar">وَلِيمَةُ الْعُرْسِ</p>
      <p class="eyebrow">Undangan Pernikahan</p>
      <h2 class="c-names"><span data-t="groom.short">Nabil</span> <em>&amp;</em> <span data-t="bride.short">Izza</span></h2>
    </div>

    <div class="sl-stage" id="envShift">
      <div class="sl-tilt" id="slTilt">
        <div class="sl-float">
          <div class="env" id="env">
            <!-- bagian dalam amplop: lapisan gading berpola geometri emas -->
            <div class="env-back"><div class="sl-liner"></div></div>

            <!-- kartu undangan di dalam amplop -->
            <div class="sl-card" id="slCard" aria-hidden="true">
              <span class="sl-card-ar">بِسْمِ اللَّهِ</span>
              <span class="sl-card-mono"><span data-t="groom.short">Nabil</span> &amp; <span data-t="bride.short">Izza</span></span>
            </div>

            <!-- kertas 2: arti ayat (bentuk lengkung/arch, miring ke kanan) -->
            <div class="sl-sheet sl-sheet-b" id="slSheetB" aria-hidden="true">
              <p class="sh-body">&ldquo;Dan di antara tanda-tanda kebesaran-Nya, Dia menciptakan pasangan-pasangan untukmu dari jenismu sendiri, agar kamu merasa tenteram kepadanya, dan Dia menjadikan di antaramu rasa kasih dan sayang.&rdquo;</p>
              <p class="sh-src">QS. Ar-Rum : 21</p>
            </div>

            <!-- kertas 1: salam (persegi lebar, miring ke kiri) -->
            <div class="sl-sheet sl-sheet-a" id="slSheetA" aria-hidden="true">
              <p class="sh-ar">السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ</p>
              <p class="sh-k">Assalamu&rsquo;alaikum Wr. Wb.</p>
              <span class="sh-rule"></span>
              <p class="sh-body">Dengan memohon rahmat dan ridha Allah Subhanahu wa Ta&rsquo;ala, kami bermaksud mengundang Bapak/Ibu/Saudara/i pada walimatul &lsquo;urs putra-putri kami.</p>
            </div>

            <!-- kantong depan -->
            <div class="env-front">
              <div class="sl-velvet"></div>
              <div class="sl-foil" aria-hidden="true"><i></i></div>
              <svg class="sl-folds" viewBox="0 0 700 500" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 500 L338 300 Q350 292 362 300 L700 500" fill="none" stroke="url(#gg)" stroke-width="1.3" opacity=".55"/>
              </svg>
              <div class="sl-to">
                <small>Kepada Yth.</small>
                <strong id="guestName">Bapak/Ibu/Saudara/i</strong>
                <i>di tempat</i>
              </div>
            </div>

            <!-- tutup amplop: luar burgundy, dalam gading berpola -->
            <!-- bayangan lembut tutup di atas badan amplop -->
            <div class="flap-cast" aria-hidden="true"></div>
            <div class="flap" aria-hidden="true">
              <div class="flap-face flap-out">
                <div class="sl-velvet"></div>
                <div class="flap-light"></div>
                <svg viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M0 0 Q25 60 43 90.5 Q50 100 57 90.5 Q75 60 100 0" fill="none" stroke="url(#gg)" stroke-width="2.4" vector-effect="non-scaling-stroke"/><path d="M7 0 Q29 55 44.2 82 Q50 91 55.8 82 Q71 55 93 0" fill="none" stroke="url(#gg)" stroke-width="1" opacity=".75" vector-effect="non-scaling-stroke"/></svg>
                <span class="flap-shade fs-out"></span>
              </div>
              <div class="flap-face flap-in">
                <div class="sl-liner"></div>
                <svg viewBox="0 0 100 100" preserveAspectRatio="none"><g transform="translate(0 100) scale(1 -1)"><path d="M0 0 Q25 60 43 90.5 Q50 100 57 90.5 Q75 60 100 0" fill="none" stroke="url(#gg)" stroke-width="2" vector-effect="non-scaling-stroke"/></g></svg>
                <span class="flap-shade fs-in"></span>
              </div>
            </div>

            <!-- segel lilin emas bermonogram -->
            <button class="seal" id="seal" type="button" aria-label="Tekan segel untuk membuka undangan">
              <span class="seal-half l"><span class="seal-face"><svg class="seal-star" viewBox="-50 -50 100 100" aria-hidden="true"><g fill="none" stroke="#6e4c17" stroke-width="1.6"><rect x="-31" y="-31" width="62" height="62"/><rect x="-31" y="-31" width="62" height="62" transform="rotate(45)"/><circle r="40" stroke-width="1"/></g></svg><span class="seal-mono" data-seal="">N&amp;I</span><span class="seal-sheen"></span></span></span>
              <span class="seal-half r"><span class="seal-face"><svg class="seal-star" viewBox="-50 -50 100 100" aria-hidden="true"><g fill="none" stroke="#6e4c17" stroke-width="1.6"><rect x="-31" y="-31" width="62" height="62"/><rect x="-31" y="-31" width="62" height="62" transform="rotate(45)"/><circle r="40" stroke-width="1"/></g></svg><span class="seal-mono" data-seal="">N&amp;I</span><span class="seal-sheen"></span></span></span>
            </button>
          </div>
        </div>
      </div>
      <div class="sl-shadow" aria-hidden="true"></div>
    </div>

    <div class="c-foot">
      <p class="hint">Sentuh segel emas untuk membuka</p>
    </div>
  </div>

  <!-- kartu undangan layar penuh -->
  <div class="sl-letter" id="slLetter" aria-hidden="true">
    <div class="sl-letter-card" id="slLetterCard">
      <img class="sl-l-flora tl" src="/images/florals/set/roses-tl-bleed.webp" alt="" aria-hidden="true" decoding="async">
      <img class="sl-l-flora br" src="/images/florals/set/roses-br-bleed.webp" alt="" aria-hidden="true" decoding="async">
      <div class="sl-letter-body">
        <p class="sl-st sl-st-0 sl-l-ar">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
        <p class="sl-st sl-st-0 sl-l-kicker">Walimatul &lsquo;Urs</p>
        <h1 class="sl-st sl-st-1 sl-l-names"><span data-t="groom.short">Nabil</span><em>&amp;</em><span data-t="bride.short">Izza</span></h1>
        <p class="sl-st sl-st-1 sl-l-full"><span data-t="groom.full">Ahmad Nabil Kholili, S.Ag.</span><br>&amp; <span data-t="bride.full">Fadilatul Izza</span></p>
        <div class="sl-st sl-st-2 sl-l-date" aria-label="Tanggal acara"><span id="letterDay">Kamis</span><i></i><b id="letterNum">21</b><i></i><span id="letterMY">Jan 2027</span></div>
        <button class="btn sl-st sl-st-3 sl-l-btn" id="slEnter" type="button"><span>Buka Undangan</span></button>
      </div>
    </div>
  </div>

  <button class="skip" id="skip" type="button">Lewati</button>
</div>
