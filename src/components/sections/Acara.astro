<!-- 4. ACARA -->
<section class="sec light" id="acara" data-g="tl tr bl br" data-gs="sm">
  <div class="ambient-floral-canvas" aria-hidden="true"></div>
  <div class="inner wide">
    <div class="rv"><p class="eyebrow-ar">الْحَفْلُ</p><p class="eyebrow">Acara</p></div>
    <h2 class="title rv" style="--d:.1s">Waktu &amp; Tempat</h2>
    <p class="sub rv" style="--d:.15s">Menuju hari bahagia</p>

    <!-- LIVE COUNTDOWN TIMER -->
    <div class="cd rv" id="cd" role="timer" aria-label="Hitung mundur menuju akad nikah">
      <div><b id="cdD">00</b><small>Hari</small></div>
      <div><b id="cdH">00</b><small>Jam</small></div>
      <div><b id="cdM">00</b><small>Menit</small></div>
      <div><b id="cdS">00</b><small>Detik</small></div>
    </div>

    <!-- CARDS ACARA AKAD & RESEPSI -->
    <div class="events">
      <!-- Akad Nikah -->
      <article class="ev rv">
        <svg class="ev-emblem" viewBox="0 0 96 84" aria-hidden="true">
          <defs><radialGradient id="emGlow"><stop offset="0" stop-color="#ffd98a" stop-opacity=".55"/><stop offset=".6" stop-color="#c9a56b" stop-opacity=".16"/><stop offset="1" stop-color="#c9a56b" stop-opacity="0"/></radialGradient></defs>
          <circle class="em-glow" cx="48" cy="42" r="40" fill="url(#emGlow)"/>
          <g class="em-float">
            <path d="M6 76H90" stroke="url(#gg)" stroke-width="1.6" stroke-linecap="round"/>
            <g fill="url(#gg)"><rect x="10" y="38" width="8" height="38" opacity=".9"/><rect x="8" y="44" width="12" height="2.4"/><path d="M10 38L14 26L18 38Z"/><rect x="78" y="38" width="8" height="38" opacity=".9"/><rect x="76" y="44" width="12" height="2.4"/><path d="M78 38L82 26L86 38Z"/></g>
