            <g fill="#260610"><rect x="13" y="52" width="2" height="8" rx="1"/><rect x="81" y="52" width="2" height="8" rx="1"/></g>
            <path d="M26 52C26 44 31 40 36 40C41 40 46 44 46 52Z" fill="url(#gg)" opacity=".8"/>
            <path d="M50 52C50 44 55 40 60 40C65 40 70 44 70 52Z" fill="url(#gg)" opacity=".8"/>
            <rect x="26" y="50" width="44" height="26" fill="#571024" stroke="url(#gg)" stroke-width="1.4"/>
            <path d="M32 52C32 32 40 24 48 24C56 24 64 32 64 52Z" fill="url(#gg)"/>
            <path d="M48 24V52M40 52C40 40 43 30 48 24M56 52C56 40 53 30 48 24" stroke="#8a6730" stroke-width=".8" fill="none" opacity=".6"/>
            <path d="M38 47C38 37 42 31 47 28" stroke="#fff1c8" stroke-width="1.3" fill="none" opacity=".55" stroke-linecap="round"/>
            <path d="M48 24V14" stroke="#c9a56b" stroke-width="1.4" stroke-linecap="round"/>
            <g class="em-cres"><path d="M49.6 2.4a6 6 0 1 0 0 11.4a4.7 4.7 0 1 1 0-11.4z" fill="#f3e3b8"/></g>
            <path d="M42 76V64a6 6 0 0 1 12 0V76Z" fill="#260610" stroke="#c9a56b" stroke-width="1.2"/>
