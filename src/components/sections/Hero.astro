<!-- 1. HERO -->
<header class="sec dark hero with-photo-backdrop" id="hero" data-g="tl tr bl br" data-gs="lg">
  <div class="ambient-floral-canvas" aria-hidden="true"></div>
  <div class="hero-photo-backdrop" id="heroPhotoBackdrop" aria-hidden="true">
    <div class="hero-photo-img" id="heroPhotoImg"></div>
    <div class="hero-photo-scrim"></div>
  </div>
  <div class="frame" aria-hidden="true"></div>
  <div class="sparkles" data-sparkles="16" aria-hidden="true"></div>
  <div data-lanterns="" aria-hidden="true"></div>
  <div class="inner">
    <p class="bismillah ar h" style="--i:0">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
    <p class="eyebrow-ar h" style="--i:1">وَلِيمَةُ الْعُرْسِ</p>
    <p class="pre-title h" style="--i:2">Walimatul &lsquo;Urs</p>
    <div class="name-stage h" style="--i:3">
      <div class="halo" data-halo="a" aria-hidden="true"></div>
      <div class="halo h2" data-halo="b" aria-hidden="true"></div>
      <h1 class="names"><span class="name" data-t="groom.short">Nabil</span><span class="amp">&amp;</span><span class="name" data-t="bride.short">Izza</span></h1>
    </div>
    <div class="date h" style="--i:4" id="heroDate">
      <span id="heroDateDay">Kamis</span>
      <i></i>
      <b id="heroDateNum">21</b>
      <i></i>
      <span id="heroDateMonthYear">Jan 2027</span>
    </div>
    <div class="cue h" style="--i:5"><small>Gulir ke bawah</small><div class="cue-line"></div></div>
  </div>
</header>
