<!-- 3. MEMPELAI -->
<section class="sec dark with-couple-bg" id="mempelai" data-g="tl tr bl br" data-gs="sm">
  <div class="ambient-floral-canvas" aria-hidden="true"></div>
  <div class="mempelai-ambient-backdrop" id="mempelaiBackdrop" aria-hidden="true">
    <div class="mempelai-backdrop-img" id="mempelaiBackdropImg"></div>
    <div class="mempelai-backdrop-scrim"></div>
  </div>
  <div class="sparkles" data-sparkles="10" aria-hidden="true"></div>
  <div class="inner wide">
    <!-- Salam pembuka (dulu section #salam terpisah). id="salam" dipertahankan agar toggle dashboard visibility.salam tetap berfungsi. -->
    <div class="mempelai-salam" id="salam">
      <p class="salam-ar ar rv" lang="ar" aria-label="Assalamu'alaikum Warahmatullahi Wabarakatuh">اَلسَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ</p>
      <div class="divider rv" data-star=""></div>
      <p class="lead rv">Dengan memohon rahmat dan ridha Allah Subhanahu wa Ta'ala, kami mengundang Bapak/Ibu/Saudara/i untuk menghadiri Pernikahan Kami.</p>
    </div>
    <div class="couple">
      <!-- Mempelai Pria -->
      <article class="person rv">
        <div class="arch-3d-stage">
          <img src="/images/florals/set/pink-trio.webp" loading="lazy" decoding="async" class="arch-layer-halo" alt="" aria-hidden="true" />
          <img src="/images/florals/frame/swag.webp" loading="lazy" decoding="async" class="arch-swag" alt="" aria-hidden="true" />
          <img src="/images/florals/904975_2801.svg" class="arch-layer-peak" alt="" aria-hidden="true" />
          <div class="arch" id="groomArch" role="img" aria-label="Ilustrasi mempelai pria">
            <svg viewBox="0 0 200 320" preserveAspectRatio="xMidYMid slice">
              <defs>
                <radialGradient id="abgG" cx="50%" cy="46%" r="75%"><stop offset="0" stop-color="#a03453"/><stop offset=".5" stop-color="#611429"/><stop offset="1" stop-color="#2a0712"/></radialGradient>
                <radialGradient id="mnG"><stop offset="0" stop-color="#e6d2a6" stop-opacity=".5"/><stop offset="1" stop-color="#e6d2a6" stop-opacity="0"/></radialGradient>
                <radialGradient id="flG"><stop offset="0" stop-color="#e6d2a6" stop-opacity=".6"/><stop offset="1" stop-color="#e6d2a6" stop-opacity="0"/></radialGradient>
              </defs>
              <rect width="200" height="320" fill="url(#abgG)"/>
              <circle cx="152" cy="58" r="38" fill="url(#mnG)"/>
              <path d="M157 42a16 16 0 1 0 0 28a12.5 12.5 0 1 1 0-28z" fill="#e6d2a6"/>
              <g fill="#e6d2a6" opacity=".9"><path d="M48 30l2 5 5 2-5 2-2 5-2-5-5-2 5-2z"/><path d="M126 18l1.4 3.4 3.4 1.4-3.4 1.4-1.4 3.4-1.4-3.4-3.4-1.4 3.4-1.4z"/><path d="M56 112l1.4 3.4 3.4 1.4-3.4 1.4-1.4 3.4-1.4-3.4-3.4-1.4 3.4-1.4z"/><path d="M152 124l1.4 3.4 3.4 1.4-3.4 1.4-1.4 3.4-1.4-3.4-3.4-1.4 3.4-1.4z"/></g>
              <path transform="translate(0 60)" d="M0 260V214H24V190l4-14 4 14V214H60C60 190 78 178 90 178C102 178 120 190 120 214H150V196l4-16 4 16V214H200V260Z" fill="#1c040b" opacity=".7"/>
              <ellipse cx="100" cy="304" rx="74" ry="11" fill="url(#flG)"/>
              <ellipse cx="100" cy="304" rx="40" ry="3.6" fill="#14030a" opacity=".5"/>
            </svg>
          </div>
        </div>
        <div class="mono" aria-hidden="true"><span data-t="groom.initial">N</span></div>
        <h3 class="pname" data-t="groom.short">Nabil</h3>
        <p class="pfull" data-t="groom.full">Ahmad Nabil Kholili, S.Ag.</p>
        <p class="pdesc"><span data-t="groom.order">Putra ke-1 dari</span><b data-t="groom.parents">Bpk. Shobirin &amp; Ibu Ummu Aiman</b></p>
        <p class="paddr" data-t="groom.address">Desa Kubangwungu RT 05 RW 03, Kec. Ketanggungan, Kab. Brebes</p>
      </article>

      <div class="amp-big rv ar" aria-hidden="true" style="direction:ltr">&amp;</div>

      <!-- Mempelai Wanita -->
      <article class="person rv" style="--d:.15s">
        <div class="arch-3d-stage">
          <img src="/images/florals/set/pink-trio.webp" loading="lazy" decoding="async" class="arch-layer-halo" alt="" aria-hidden="true" />
          <img src="/images/florals/frame/swag.webp" loading="lazy" decoding="async" class="arch-swag" alt="" aria-hidden="true" />
          <img src="/images/florals/904975_2801.svg" class="arch-layer-peak" alt="" aria-hidden="true" />
          <div class="arch" id="brideArch" role="img" aria-label="Ilustrasi mempelai wanita">
            <svg viewBox="0 0 200 320" preserveAspectRatio="xMidYMid slice">
              <defs>
                <radialGradient id="abgB" cx="50%" cy="46%" r="75%"><stop offset="0" stop-color="#a03453"/><stop offset=".5" stop-color="#611429"/><stop offset="1" stop-color="#2a0712"/></radialGradient>
                <radialGradient id="mnB"><stop offset="0" stop-color="#e6d2a6" stop-opacity=".5"/><stop offset="1" stop-color="#e6d2a6" stop-opacity="0"/></radialGradient>
                <radialGradient id="flB"><stop offset="0" stop-color="#e6d2a6" stop-opacity=".6"/><stop offset="1" stop-color="#e6d2a6" stop-opacity="0"/></radialGradient>
              </defs>
              <rect width="200" height="320" fill="url(#abgB)"/>
              <circle cx="48" cy="58" r="38" fill="url(#mnB)"/>
              <path d="M53 42a16 16 0 1 1 0 28a12.5 12.5 0 1 0 0-28z" fill="#e6d2a6"/>
              <g fill="#e6d2a6" opacity=".9"><path d="M152 30l2 5 5 2-5 2-2 5-2-5-5-2 5-2z"/><path d="M74 18l1.4 3.4 3.4 1.4-3.4 1.4-1.4 3.4-1.4-3.4-3.4-1.4 3.4-1.4z"/><path d="M160 112l1.4 3.4 3.4 1.4-3.4 1.4-1.4 3.4-1.4-3.4-3.4-1.4 3.4-1.4z"/><path d="M48 124l1.4 3.4 3.4 1.4-3.4 1.4-1.4 3.4-1.4-3.4-3.4-1.4 3.4-1.4z"/></g>
              <path transform="translate(0 60)" d="M0 260V214H24V190l4-14 4 14V214H60C60 190 78 178 90 178C102 178 120 190 120 214H150V196l4-16 4 16V214H200V260Z" fill="#1c040b" opacity=".7"/>
              <ellipse cx="100" cy="304" rx="74" ry="11" fill="url(#flB)"/>
              <ellipse cx="100" cy="304" rx="40" ry="3.6" fill="#14030a" opacity=".5"/>
            </svg>
          </div>
        </div>
        <div class="mono" aria-hidden="true"><span data-t="bride.initial">I</span></div>
        <h3 class="pname" data-t="bride.short">Izza</h3>
        <p class="pfull" data-t="bride.full">Fadilatul Izza</p>
        <p class="pdesc"><span data-t="bride.order">Putri ke-3 dari</span><b data-t="bride.parents">Bpk. Rosihin &amp; Ibu Siti Chulasoh</b></p>
        <p class="paddr" data-t="bride.address">Desa Kubangwungu RT 08 RW 01, Kec. Ketanggungan, Kab. Brebes</p>
      </article>
    </div>
  </div>
</section>
