<!-- 7. RSVP (KONFIRMASI KEHADIRAN) -->
<section class="sec light" id="rsvp" data-g="tl tr bl br" data-gs="sm">
  <div class="ambient-floral-canvas" aria-hidden="true"></div>
  <div class="inner">
    <div class="rv"><p class="eyebrow-ar">تَأْكِيدُ الْحُضُورِ</p><p class="eyebrow">RSVP</p></div>
    <h2 class="title rv" style="--d:.1s">Konfirmasi Kehadiran</h2>
    <p class="lead rv" style="--d:.15s">Mohon konfirmasi kehadiran Anda agar kami dapat mempersiapkan segalanya dengan sebaik-baiknya.</p>
    <form class="form rv" id="form" autocomplete="off">
      <div><label class="fl" for="fName">Nama</label><input class="fi" id="fName" name="nama" type="text" required maxlength="80" placeholder="Nama lengkap Anda"></div>
      <div>
        <span class="fl" id="lAtt">Kehadiran</span>
        <div class="radios" role="radiogroup" aria-labelledby="lAtt">
          <label><input type="radio" name="hadir" value="Hadir" required><span>Insya Allah Hadir</span></label>
          <label><input type="radio" name="hadir" value="Berhalangan"><span>Berhalangan</span></label>
        </div>
      </div>
      <div><label class="fl" for="fCount">Jumlah Tamu</label>
        <select class="sel" id="fCount" name="jumlah"><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option></select></div>
      <div><label class="fl" for="fMsg">Doa &amp; Ucapan</label><textarea class="ta" id="fMsg" name="pesan" maxlength="400" placeholder="Tuliskan doa dan ucapan untuk kedua mempelai"></textarea></div>
      <button class="btn" type="submit" style="background:linear-gradient(135deg,var(--wine-800),var(--wine-950));color:#fff1d2;font-weight:500;border-color:var(--wine-900)">Kirim Konfirmasi</button>
    </form>
    <div class="result" id="result" hidden>
      <h3>Pesan Anda</h3>
      <pre id="resMsg"></pre>
      <div class="rbtn">
        <a class="btn" id="waBtn" href="#" target="_blank" rel="noopener">Kirim lewat WhatsApp</a>
        <button class="btn ghost" id="copyMsg" type="button">Salin Pesan</button>
        <button class="btn ghost" id="editMsg" type="button">Ubah</button>
      </div>
    </div>
  </div>
</section>
