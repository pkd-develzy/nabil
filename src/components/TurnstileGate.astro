---
// Gerbang Keamanan Turnstile (Pre-Gate Screen)
// Muncul di awal sebelum menampilkan apapun untuk melindungi privasi mempelai dari bot & scraper.
const SITE_KEY = "0x4AAAAAAFspfVyDnt3bG0U0";
---
<div id="turnstileGate" aria-label="Gerbang Keamanan Undangan">
  <div class="gate-backdrop" aria-hidden="true"></div>
  <div class="gate-card">
    <div class="gate-crest">
      <div class="gate-seal">N&amp;I</div>
    </div>
    
    <p class="gate-eyebrow">Undangan Pernikahan</p>
    <h1 class="gate-title">Nabil <em>&amp;</em> Izza</h1>
    
    <div class="gate-divider"><span>✦</span></div>

    <h2 class="gate-subtitle">Verifikasi Keamanan Tamu</h2>
    <p class="gate-desc">
      Mohon tunggu sejenak, sistem sedang memastikan Anda adalah tamu sesungguhnya untuk melindungi privasi kedua mempelai.
    </p>

    <!-- Turnstile Widget Cloudflare -->
    <div class="gate-turnstile-wrap">
      <div 
        class="cf-turnstile" 
        data-sitekey={SITE_KEY} 
        data-theme="dark"
        data-size="normal"
        data-action="enter_invitation"
        data-callback="__onTurnstileSuccess"
        data-error-callback="__onTurnstileError"
        data-expired-callback="__onTurnstileExpired"
      ></div>
    </div>

    <!-- Status Teks & Spinner -->
    <div class="gate-status" id="gateStatus">
      <span class="gate-spinner" id="gateSpinner"></span>
      <span id="gateStatusText">Memeriksa keamanan pengunjung...</span>
    </div>
  </div>
</div>

<style>
#turnstileGate {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  z-index: 9999999;
  background: radial-gradient(ellipse at 50% 38%, #4d0f22 0%, #260610 75%, #140207 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  box-sizing: border-box;
  opacity: 1;
  visibility: visible;
  transition: opacity .7s cubic-bezier(.65,0,.15,1), visibility .7s;
  overflow: hidden;
}

#turnstileGate.verified {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.gate-backdrop {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle at center, rgba(201,165,107,.12) 0%, transparent 70%),
                    radial-gradient(rgba(201,165,107,.15) 1px, transparent 1px);
  background-size: 100% 100%, 28px 28px;
  pointer-events: none;
}

.gate-card {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 440px;
  padding: clamp(28px, 6vw, 42px) clamp(20px, 5vw, 34px);
  border-radius: 24px;
  background: linear-gradient(165deg, rgba(77,15,34,.88) 0%, rgba(38,6,16,.96) 100%);
  border: 1.5px solid rgba(201,165,107,.55);
  box-shadow: 0 25px 60px rgba(0,0,0,.65), 0 0 30px rgba(201,165,107,.15);
  text-align: center;
  color: #fff;
  box-sizing: border-box;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.gate-crest {
  display: flex;
  justify-content: center;
  margin-bottom: 14px;
}

.gate-seal {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #ffd98a 0%, #c9a56b 50%, #8a6730 100%);
  border: 2px solid #fff2c8;
  box-shadow: 0 6px 18px rgba(0,0,0,.4), 0 0 15px rgba(255,217,138,.35);
  color: #260610;
  font-family: 'Cinzel', serif;
  font-weight: 700;
  font-size: 1.15rem;
  letter-spacing: .08em;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gate-eyebrow {
  font-family: 'Cinzel', serif;
  font-size: .72rem;
  letter-spacing: .28em;
  text-transform: uppercase;
  color: #e6d2a6;
  margin: 0 0 4px;
}

.gate-title {
  font-family: 'Cormorant Garamond', 'Cinzel', serif;
  font-size: clamp(1.8rem, 5vw, 2.3rem);
  font-weight: 600;
  color: #fff;
  margin: 0 0 12px;
  line-height: 1.2;
}

.gate-title em {
  font-family: 'Hugh is Life', cursive, serif;
  color: #ffd98a;
  font-style: italic;
  font-weight: 400;
  margin: 0 4px;
}

.gate-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin: 0 auto 16px;
  color: #c9a56b;
  font-size: .85rem;
}

.gate-divider::before,
.gate-divider::after {
  content: "";
  width: 50px;
  height: 1px;
  background: linear-gradient(90deg, transparent, #c9a56b);
}
.gate-divider::after {
  transform: scaleX(-1);
}

.gate-subtitle {
  font-family: 'Cinzel', serif;
  font-size: clamp(.92rem, 2.5vw, 1.05rem);
  font-weight: 600;
  color: #ffd98a;
  letter-spacing: .08em;
  text-transform: uppercase;
  margin: 0 0 8px;
}

.gate-desc {
  font-family: 'Jost', sans-serif;
  font-size: clamp(.84rem, 2.3vw, .92rem);
  font-weight: 300;
  color: #e2cbbb;
  line-height: 1.6;
  margin: 0 0 20px;
}

.gate-turnstile-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 65px;
  margin: 0 auto 16px;
}

.gate-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-family: 'Jost', sans-serif;
  font-size: .82rem;
  color: #e6d2a6;
  padding: 6px 14px;
  border-radius: 20px;
  background: rgba(38,6,16,.5);
  border: 1px solid rgba(201,165,107,.25);
}

.gate-spinner {
  display: inline-block;
  width: 12px;
  height: 12px;
  border: 2px solid rgba(230,210,166,.3);
  border-top-color: #ffd98a;
  border-radius: 50%;
  animation: gateSpin .8s linear infinite;
}

@keyframes gateSpin {
  to { transform: rotate(360deg); }
}

.gate-check {
  color: #4ade80;
  font-weight: bold;
}
</style>

<script is:inline>
(function() {
  var gate = document.getElementById('turnstileGate');
  var statusText = document.getElementById('gateStatusText');
  var spinner = document.getElementById('gateSpinner');

  function unlockGate() {
    if (!gate) return;
    gate.classList.add('verified');
    setTimeout(function() {
      try { gate.remove(); } catch(e) { gate.style.display = 'none'; }
      window.dispatchEvent(new CustomEvent('azluna:gate-passed'));
    }, 720);
  }

  // Jika pengunjung sudah terverifikasi dalam sesi ini, langsung buka tanpa jeda
  try {
    if (sessionStorage.getItem('azluna_turnstile_verified') === '1') {
      unlockGate();
      return;
    }
  } catch(e) {}

  window.__onTurnstileSuccess = function(token) {
    if (statusText) statusText.textContent = "Verifikasi berhasil. Membuka undangan...";
    if (spinner) spinner.style.borderTopColor = "#4ade80";

    // Kirim token ke backend untuk validasi resmi server-side
    fetch('/api/verify-turnstile', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token: token })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data && data.success) {
        try { sessionStorage.setItem('azluna_turnstile_verified', '1'); } catch(e) {}
        setTimeout(unlockGate, 350);
      } else {
        if (statusText) statusText.textContent = (data && data.error) || "Verifikasi tidak valid. Silakan coba lagi.";
        if (spinner) spinner.style.display = "none";
      }
    })
    .catch(function() {
      // Fallback jika fetch offline/terkendala tapi token sudah valid dari Cloudflare
      try { sessionStorage.setItem('azluna_turnstile_verified', '1'); } catch(e) {}
      setTimeout(unlockGate, 400);
    });
  };

  window.__onTurnstileError = function() {
    if (statusText) statusText.textContent = "Verifikasi tertunda. Mohon periksa koneksi internet Anda.";
    if (spinner) spinner.style.display = "none";
  };

  window.__onTurnstileExpired = function() {
    if (statusText) statusText.textContent = "Sesi verifikasi berakhir. Mohon muat ulang.";
    if (spinner) spinner.style.display = "none";
  };
})();
</script>

