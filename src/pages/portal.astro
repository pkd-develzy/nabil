      }
      .template-pills {
        grid-template-columns: 1fr 1fr !important;
      }

      /* Responsive Guest Card Transformation (Bukan tabel kaku yang scroll horizontal) */
      .table-container {
        border: none;
        overflow: visible;
        background: transparent;
        box-shadow: none;
      }
      .guest-table, .guest-table tbody, .guest-table tr, .guest-table td {
        display: block;
        width: 100%;
      }
      .guest-table thead {
        display: none; /* Sembunyikan header tabel di mobile */
      }
      .guest-table tr {
        background: rgba(30, 5, 12, 0.85);
        border: 1px solid rgba(201, 165, 107, 0.35);
