            '<div class="rsvp-avatar">' + firstLetter + '</div>' +
            '<div class="rsvp-user-info">' +
              '<div class="rsvp-user-name-row">' +
                '<h3 class="rsvp-user-name" title="' + escapeHtml(r.name) + '">' + escapeHtml(r.name) + '</h3>' +
