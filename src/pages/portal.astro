  <!-- SCRIPT LOGIKA PORTAL -->
  <script is:inline>
    // Konfigurasi Kunci Acara & State
    var PORTAL_AUTH_KEY = 'azluna_portal_auth_nabil';
    var GUESTS_STORAGE_KEY = 'azluna_guest_list_nabil';
    var CURRENT_CATEGORY = 'Umum';
    var CURRENT_TEMPLATE = 'formal';

    // 1. OTENTIKASI PENGANTIN
    function checkAuth() {
      var isAuth = localStorage.getItem(PORTAL_AUTH_KEY) === '1';
      if (isAuth) {
        document.getElementById('loginModal').classList.add('hidden');
        document.getElementById('portalContent').classList.remove('hidden');
        renderGuestTable();
        updateMessagePreview();
        fetchGuestsFromD1();
        fetchRsvpsFromD1();
      } else {
        document.getElementById('loginModal').classList.remove('hidden');
        document.getElementById('portalContent').classList.add('hidden');
      }
    }

    function togglePasswordVisibility() {
      var input = document.getElementById('loginPass');
      var eyeOpen = document.getElementById('eyeOpen');
      var eyeClosed = document.getElementById('eyeClosed');
      if (!input) return;
      if (input.type === 'password') {
        input.type = 'text';
        if (eyeOpen) eyeOpen.style.display = 'none';
        if (eyeClosed) eyeClosed.style.display = 'block';
      } else {
        input.type = 'password';
        if (eyeOpen) eyeOpen.style.display = 'block';
        if (eyeClosed) eyeClosed.style.display = 'none';
      }
    }

    function handleLogin(e) {
      e.preventDefault();
      var pass = document.getElementById('loginPass').value.trim();
      var err = document.getElementById('loginError');
      if (pass === 'Izza-Nabil2027') {
        localStorage.setItem(PORTAL_AUTH_KEY, '1');
        err.style.display = 'none';
        checkAuth();
        showToast('Selamat datang di Portal Pengantin!');
      } else {
        err.style.display = 'block';
        var box = document.querySelector('.login-box');
        box.style.animation = 'none';
        box.offsetHeight;
        box.style.animation = 'modalFadeIn 0.3s ease';
      }
      return false;
    }

    function handleLogout() {
      if (confirm('Apakah Anda ingin keluar dari portal?')) {
        localStorage.removeItem(PORTAL_AUTH_KEY);
        location.reload();
      }
    }

    // 2. KELOLA DATA TAMU DI LOCALSTORAGE & CLOUDFLARE D1
    function getStoredGuests() {
      try {
        var data = localStorage.getItem(GUESTS_STORAGE_KEY);
        return data ? JSON.parse(data) : [];
      } catch(e) { return []; }
    }

    function saveStoredGuests(list) {
      try {
        localStorage.setItem(GUESTS_STORAGE_KEY, JSON.stringify(list));
      } catch(e) {}
      renderGuestTable();
    }

    // Mengambil daftar tamu terbaru dari Cloudflare D1
    function fetchGuestsFromD1() {
      fetch('/api/guests')
        .then(function(res) {
          if (!res.ok) throw new Error('Status: ' + res.status);
          return res.json();
        })
        .then(function(res) {
          if (res && res.success && Array.isArray(res.data)) {
            var formatted = res.data.map(function(item) {
              return {
                id: String(item.id),
                name: item.name,
                phone: item.phone || '',
                category: item.category || 'Umum',
                sent: !!item.sent,
                createdAt: item.created_at || new Date().toISOString()
              };
            });
            saveStoredGuests(formatted);
          }
        })
        .catch(function(err) {
          console.warn('Gagal sinkronisasi data D1 (menggunakan data lokal):', err);
        });
    }

    // 3. GENERATOR LINK & TEMPLATE PESAN
    function getBaseUrl() {
      return window.location.origin + '/';
    }

    function buildGuestUrl(name, category) {
      var clean = (name || '').trim();
      if (!clean) return getBaseUrl();
      var cat = (category || CURRENT_CATEGORY || '').trim();
      var url = getBaseUrl() + '?to=' + encodeURIComponent(clean);
      if (cat && cat !== 'ALL') {
        url += '&c=' + encodeURIComponent(cat);
      }
      if (cat === 'Grup WA' || cat.toLowerCase().indexOf('grup') !== -1 || cat.toLowerCase().indexOf('group') !== -1) {
        url += '&grp=1';
      }
      return url;
    }

    function formatWhatsAppNumber(phone) {
      if (!phone) return '';
      var clean = phone.replace(/[^0-9]/g, '');
      if (clean.indexOf('08') === 0) {
        clean = '628' + clean.slice(2);
      } else if (clean.indexOf('8') === 0 && clean.length >= 9) {
        clean = '628' + clean.slice(1);
      }
      return clean;
    }

    function generateMessage(name, link, style) {
      var guestName = name ? name.trim() : '[Nama Tamu]';
      var inviteLink = link || buildGuestUrl(name);

      if (style === 'grup') {
        return "Assalamu’alaikum Warahmatullahi Wabarakatuh.\n\n" +
          "Kepada Sahabat & Rekan-Rekan di:\n" +
          guestName + "\n\n" +
          "Tanpa mengurangi rasa hormat, dengan memohon rahmat dan ridha Allah SWT, perkenankan kami mengundang seluruh sahabat dan rekan sekalian untuk menghadiri acara pernikahan kami:\n\n" +
          "🤵 Ahmad Nabil Kholili, S.Ag.\n" +
          "👰 Fadilatul Izza\n\n" +
          "🗓️ Hari/Tanggal: Kamis, 21 Januari 2027\n" +
          "📍 Tempat: Kediaman Mempelai Wanita, Desa Kubangwungu RT 08 RW 01, Kec. Ketanggungan, Kab. Brebes\n\n" +
          "Mohon doa restu serta berkenan mengisi konfirmasi kehadiran (RSVP) masing-masing melalui tautan undangan resmi berikut:\n\n" +
          inviteLink + "\n\n" +
          "Kehadiran serta doa restu rekan-rekan sekalian merupakan kehormatan dan kebahagiaan bagi kami sekeluarga.\n\n" +
          "Wassalamu’alaikum Warahmatullahi Wabarakatuh.\n\n" +
          "Hormat kami,\n" +
          "Nabil & Izza";
      }

      if (style === 'santai') {
        return "Halo " + guestName + "!\n\n" +
          "Kabar bahagia! Insya Allah kami akan melangsungkan pernikahan:\n\n" +
          "💍 Ahmad Nabil Kholili & Fadilatul Izza\n" +
          "📅 Kamis, 21 Januari 2027\n\n" +
          "Kami sangat berharap kehadiranmu untuk merayakan momen bahagia ini bersama kami. Informasi lengkap acara dan ucapan bisa dibuka lewat link undangan berikut:\n\n" +
          inviteLink + "\n\n" +
          "Sampai jumpa di hari bahagia kami!\n\n" +
          "— Nabil & Izza";
      }

      if (style === 'keluarga') {
        return "Assalamu'alaikum Warahmatullahi Wabarakatuh.\n\n" +
          "Kepada Yth. Keluarga Tercinta:\n" +
          guestName + "\n\n" +
          "Dengan memohon rahmat dan ridho Allah SWT, kami bermaksud mengundang sanak saudara sekalian dalam acara walimatul 'urs putra-putri kami:\n\n" +
          "Ahmad Nabil Kholili & Fadilatul Izza\n" +
          "Hari/Tgl: Kamis, 21 Januari 2027\n" +
          "Lokasi: Brebes, Jawa Tengah\n\n" +
          "Detail rangkaian acara serta doa restu dapat diakses melalui tautan undangan digital di bawah ini:\n\n" +
          inviteLink + "\n\n" +
          "Kehadiran serta doa restu dari Bapak/Ibu/Saudara/i merupakan kebahagiaan dan kehormatan besar bagi keluarga kami.\n\n" +
          "Wassalamu'alaikum Warahmatullahi Wabarakatuh.\n\n" +
          "Keluarga Besar Bpk. Shobirin & Bpk. Rosihin\n" +
          "Nabil & Izza";
      }

      // Default: Formal & Sopan
      return "Kepada Yth.\n" +
        "Bapak/Ibu/Saudara/i " + guestName + "\n\n" +
        "Assalamu'alaikum Warahmatullahi Wabarakatuh.\n\n" +
        "Tanpa mengurangi rasa hormat, perkenankan kami mengundang Bapak/Ibu/Saudara/i untuk menghadiri acara pernikahan kami:\n\n" +
        "Ahmad Nabil Kholili, S.Ag.\n" +
        "&\n" +
        "Fadilatul Izza\n\n" +
        "Yang insya Allah akan dilaksanakan pada:\n" +
        "Hari/Tanggal: Kamis, 21 Januari 2027\n" +
        "Tempat: Brebes, Jawa Tengah\n\n" +
        "Informasi lengkap mengenai jadwal akad, resepsi, dan peta lokasi dapat dilihat melalui tautan undangan resmi berikut:\n\n" +
        inviteLink + "\n\n" +
        "Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir untuk memberikan doa restu kepada kedua mempelai.\n\n" +
        "Wassalamu'alaikum Warahmatullahi Wabarakatuh.\n\n" +
        "Hormat kami,\n" +
        "Nabil & Izza";
    }

    function updateMessagePreview() {
      var name = document.getElementById('guestName').value;
      var link = buildGuestUrl(name, CURRENT_CATEGORY);
      document.getElementById('linkPreview').value = link;
      var msg = generateMessage(name, link, CURRENT_TEMPLATE);
      document.getElementById('messagePreview').value = msg;
    }

    function selectCategory(btn) {
      document.querySelectorAll('#categoryGroup .pill-btn').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      CURRENT_CATEGORY = btn.getAttribute('data-cat');
      if (CURRENT_CATEGORY === 'Grup WA') {
        var tplBtn = document.querySelector('#templateGroup .pill-btn[data-tpl="grup"]');
        if (tplBtn) {
          document.querySelectorAll('#templateGroup .pill-btn').forEach(function(b){ b.classList.remove('active'); });
          tplBtn.classList.add('active');
          CURRENT_TEMPLATE = 'grup';
        }
      }
      updateMessagePreview();
    }

    function selectTemplate(btn) {
      document.querySelectorAll('#templateGroup .pill-btn').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      CURRENT_TEMPLATE = btn.getAttribute('data-tpl');
      updateMessagePreview();
    }

    // 4. AKSI PENGIRIMAN & CLIPBOARD
    function sendWhatsAppNow() {
      var name = document.getElementById('guestName').value.trim();
      var phone = formatWhatsAppNumber(document.getElementById('guestPhone').value.trim());
      var msg = document.getElementById('messagePreview').value.trim();

      if (!name) {
        alert('Mohon masukkan nama tamu undangan terlebih dahulu.');
        document.getElementById('guestName').focus();
        return;
      }

      // Auto save or update status
      markOrAddGuest(name, phone, CURRENT_CATEGORY, true);

      var url = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(msg);
      if (phone) {
        url = 'https://api.whatsapp.com/send?phone=' + phone + '&text=' + encodeURIComponent(msg);
      }
      window.open(url, '_blank');
      showToast('Membuka WhatsApp untuk ' + name);
    }

    function copyToClipboard(text, successMsg) {
      if (!text) return;
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(function(){
          showToast(successMsg);
        }).catch(function(){
          fallbackCopy(text, successMsg);
        });
      } else {
        fallbackCopy(text, successMsg);
      }
    }

    function fallbackCopy(text, successMsg) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.left = '-9999px';
      ta.style.top = '0';
      ta.setAttribute('readonly', '');
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try {
        var ok = document.execCommand('copy');
        if (ok) showToast(successMsg);
        else alert('Silakan salin teks manual:\n' + text);
      } catch (err) {
        prompt('Silakan salin manual:', text);
      }
      document.body.removeChild(ta);
    }

    function copyFullMessage() {
      var msg = document.getElementById('messagePreview').value;
      if (!msg) return;
      copyToClipboard(msg, 'Teks pesan WhatsApp berhasil disalin!');
    }

    function copyLinkOnly() {
      var link = document.getElementById('linkPreview').value;
      if (!link) return;
      copyToClipboard(link, 'Tautan undangan berhasil disalin!');
    }

    function markOrAddGuest(name, phone, category, isSent) {
      var list = getStoredGuests();
      var found = list.find(function(g){ return g.name.toLowerCase() === name.toLowerCase(); });
      var targetGuest = null;

      if (found) {
        if (phone) found.phone = phone;
        if (category) found.category = category;
        if (isSent !== undefined) found.sent = !!isSent;
        targetGuest = found;
      } else {
        targetGuest = {
          id: Date.now().toString(),
          name: name,
          phone: phone,
          category: category || 'Umum',
          sent: !!isSent,
          createdAt: new Date().toISOString()
        };
        list.unshift(targetGuest);
      }
      saveStoredGuests(list);

      // Sinkronkan ke Cloudflare D1
      if (targetGuest) {
        fetch('/api/guests', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: targetGuest.id,
            name: targetGuest.name,
            category: targetGuest.category,
            phone: targetGuest.phone,
            sent: targetGuest.sent ? 1 : 0
          })
        }).catch(function(err){
          console.warn('Gagal sync tamu ke Cloudflare D1:', err);
        });
      }
    }

    function saveGuest() {
      var name = document.getElementById('guestName').value.trim();
      var phone = formatWhatsAppNumber(document.getElementById('guestPhone').value.trim());
      if (!name) {
        alert('Mohon masukkan nama tamu undangan.');
        document.getElementById('guestName').focus();
        return;
      }
      markOrAddGuest(name, phone, CURRENT_CATEGORY, false);
      showToast('Tamu ' + name + ' berhasil disimpan!');
      resetForm();
    }

    function resetForm() {
      document.getElementById('guestName').value = '';
      document.getElementById('guestPhone').value = '';
      updateMessagePreview();
    }

    // 5. RENDER DAFTAR TAMU & STATISTIK
    function renderGuestTable() {
      var list = getStoredGuests();
      var tbody = document.getElementById('guestTableBody');
      var search = (document.getElementById('searchGuest').value || '').toLowerCase().trim();
      var filterCat = document.getElementById('filterCategory').value;
      var filterSt = document.getElementById('filterStatus').value;

      // Hitung Statistik
      var total = list.length;
      var sent = list.filter(function(g){ return g.sent; }).length;

      var elTotal = document.getElementById('statTotal');
      var elSent = document.getElementById('statSent');

      if (elTotal) elTotal.textContent = total;
      if (elSent) elSent.textContent = sent;

      // Filter
      var filtered = list.filter(function(g){
        var matchName = !search || g.name.toLowerCase().indexOf(search) !== -1;
        var matchCat = filterCat === 'ALL' || g.category === filterCat;
        var matchSt = filterSt === 'ALL' || (filterSt === 'sent' && g.sent) || (filterSt === 'unsent' && !g.sent);
        return matchName && matchCat && matchSt;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:32px;color:rgba(242,224,190,0.6)">Belum ada data tamu yang sesuai.</td></tr>';
        return;
      }

      var html = '';
      filtered.forEach(function(g, idx){
        var link = buildGuestUrl(g.name, g.category);
        var cleanPhone = g.phone ? g.phone.replace(/[^0-9]/g, '') : '';
        var statusBadge = g.sent ?
          '<button type="button" class="badge badge-sent" title="Klik untuk ubah status" onclick="toggleSentStatus(\'' + g.id + '\')"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Terkirim</button>' :
          '<button type="button" class="badge badge-unsent" title="Klik untuk ubah status" onclick="toggleSentStatus(\'' + g.id + '\')"><span class="status-dot"></span> Belum Kirim</button>';

        var isGrp = g.category === 'Grup WA' || (g.category || '').toLowerCase().indexOf('grup') !== -1;
        html += '<tr class="guest-row">' +
          '<td class="td-num">' +
            '<span class="num-badge">' + (idx + 1) + '</span>' +
          '</td>' +
          '<td class="td-name">' +
            '<div class="guest-name-cell">' +
              '<span class="guest-name-text">' + escapeHtml(g.name) + '</span>' +
              '<span class="badge badge-cat' + (isGrp ? ' badge-cat-grp' : '') + '">' + (isGrp ? '👥 ' : '') + escapeHtml(g.category) + '</span>' +
            '</div>' +
          '</td>' +
          '<td class="td-phone">' +
            '<span class="mobile-label">WhatsApp</span>' +
            (cleanPhone ?
              '<a href="https://wa.me/' + cleanPhone + '" target="_blank" class="guest-phone-link" title="Chat WhatsApp">' +
                '<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/></svg>' +
                '<span>' + escapeHtml(g.phone) + '</span>' +
              '</a>' :
              '<span class="no-phone">Tanpa Nomor</span>'
            ) +
          '</td>' +
          '<td class="td-status">' +
            '<span class="mobile-label">Status</span>' + statusBadge +
          '</td>' +
          '<td class="td-actions">' +
            '<div class="action-btn-group">' +
              '<button type="button" class="btn btn-wa btn-sm" onclick="quickSendWA(\'' + g.id + '\')" title="Kirim via WhatsApp">' +
                '<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/></svg>' +
                '<span>Kirim WA</span>' +
              '</button>' +
              '<button type="button" class="btn btn-outline btn-sm" onclick="quickCopyLink(\'' + g.id + '\')" title="Salin Tautan">' +
                '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>' +
                '<span>Salin</span>' +
              '</button>' +
              '<a href="' + link + '" target="_blank" class="btn btn-outline btn-sm" title="Buka Undangan">' +
                '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>' +
                '<span>Buka</span>' +
              '</a>' +
              '<button type="button" class="btn-danger-sm" onclick="deleteGuest(\'' + g.id + '\')" title="Hapus">' +
                '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>' +
              '</button>' +
            '</div>' +
          '</td>' +
        '</tr>';
      });
      tbody.innerHTML = html;
    }

    function toggleSentStatus(id) {
      var list = getStoredGuests();
      var item = list.find(function(g){ return g.id === id; });
      if (item) {
        item.sent = !item.sent;
        saveStoredGuests(list);
        // Sync ke Cloudflare D1
        fetch('/api/guests', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: item.id,
            name: item.name,
            category: item.category,
            phone: item.phone,
            sent: item.sent ? 1 : 0
          })
        }).catch(function(e){});
      }
    }

    function quickSendWA(id) {
      var list = getStoredGuests();
      var item = list.find(function(g){ return g.id === id; });
      if (!item) return;
      var link = buildGuestUrl(item.name, item.category);
      var msg = generateMessage(item.name, link, CURRENT_TEMPLATE);
      var url = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(msg);
      if (item.phone) {
        url = 'https://api.whatsapp.com/send?phone=' + item.phone + '&text=' + encodeURIComponent(msg);
      }
      item.sent = true;
      saveStoredGuests(list);
      // Sync status terkirim ke D1
      fetch('/api/guests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: item.id,
          name: item.name,
          category: item.category,
          phone: item.phone,
          sent: 1
        })
      }).catch(function(e){});

      window.open(url, '_blank');
      showToast('Membuka WhatsApp untuk ' + item.name);
    }

    function quickCopyLink(id) {
      var list = getStoredGuests();
      var item = list.find(function(g){ return g.id === id; });
      if (!item) return;
      var link = buildGuestUrl(item.name, item.category);
      copyToClipboard(link, 'Link undangan ' + item.name + ' berhasil disalin!');
    }

    function deleteGuest(id) {
      if (confirm('Hapus tamu ini dari daftar?')) {
        var list = getStoredGuests().filter(function(g){ return g.id !== id; });
        saveStoredGuests(list);
        showToast('Tamu telah dihapus.');
        // Hapus dari Cloudflare D1
        fetch('/api/guests?id=' + encodeURIComponent(id), {
          method: 'DELETE'
        }).catch(function(err){
          console.warn('Gagal menghapus dari D1:', err);
        });
      }
    }

    function clearAllGuests() {
      if (confirm('PERINGATAN: Apakah Anda yakin ingin menghapus SEMUA daftar tamu?')) {
        localStorage.removeItem(GUESTS_STORAGE_KEY);
        renderGuestTable();
        showToast('Semua tamu berhasil dibersihkan.');
      }
    }

    function exportRecapText() {
      var list = getStoredGuests();
      if (!list.length) {
        alert('Daftar tamu masih kosong.');
        return;
      }
      var text = "REKAPITULASI TAMU UNDANGAN NABIL & IZZA\n";
      text += "Total: " + list.length + " Tamu\n\n";
      list.forEach(function(g, i){
        var st = g.sent ? '[SUDAH TERKIRIM]' : '[BELUM KIRIM]';
        text += (i + 1) + ". " + g.name + " (" + g.category + ") " + st + "\n";
        text += "   Link: " + buildGuestUrl(g.name, g.category) + "\n";
        if (g.phone) text += "   WA: " + g.phone + "\n";
        text += "\n";
      });
      copyToClipboard(text, 'Rekapitulasi seluruh tamu berhasil disalin!');
    }

    // 6. LOGIKA REKAPITULASI RSVP DARI CLOUDFLARE D1 (CARD GRID SYSTEM)
    var RSVP_LIST = [];
    var RSVP_ACTIVE_TAB = 'all';

    function fetchRsvpsFromD1(showToastMsg) {
      fetch('/api/rsvps?admin=1')
        .then(function(res){
          if (!res.ok) throw new Error('Status: ' + res.status);
          return res.json();
        })
        .then(function(json){
          if (json && json.success && Array.isArray(json.data)) {
            RSVP_LIST = json.data;
            renderRsvpCards();
            if (showToastMsg) showToast('Data RSVP berhasil diperbarui!');
          }
        })
        .catch(function(err){
          console.warn('Gagal memuat data RSVP dari D1:', err);
        });
    }

    function setRsvpFilterTab(tab) {
      RSVP_ACTIVE_TAB = tab;
      var tabs = ['all', 'visible', 'hidden'];
      tabs.forEach(function(t) {
        var el = document.getElementById(t === 'all' ? 'tabRsvpAll' : (t === 'visible' ? 'tabRsvpVisible' : 'tabRsvpHidden'));
        if (el) {
          if (t === tab) el.classList.add('active');
          else el.classList.remove('active');
        }
      });
      renderRsvpCards();
    }

    function updateRsvpStatsAndTabs() {
      var hadirList = RSVP_LIST.filter(function(r){ return (r.attendance || '').toLowerCase() === 'hadir'; });
      var totalPax = hadirList.reduce(function(acc, r){ return acc + (parseInt(r.pax, 10) || 1); }, 0);
      var statHadirEl = document.getElementById('statRsvpHadir');
      var statTotalEl = document.getElementById('statRsvpTotal');
      if (statHadirEl) statHadirEl.textContent = totalPax + ' Org';
      if (statTotalEl) statTotalEl.textContent = RSVP_LIST.length;

      var visibleCount = RSVP_LIST.filter(function(r){ return r.is_visible !== 0; }).length;
      var hiddenCount = RSVP_LIST.filter(function(r){ return r.is_visible === 0; }).length;

      var tabAllEl = document.getElementById('tabCountAll');
      var tabVisEl = document.getElementById('tabCountVisible');
      var tabHidEl = document.getElementById('tabCountHidden');

      if (tabAllEl) tabAllEl.textContent = RSVP_LIST.length;
      if (tabVisEl) tabVisEl.textContent = visibleCount;
      if (tabHidEl) tabHidEl.textContent = hiddenCount;
    }

    function getAvatarColor(name) {
      var colors = [
        '#e5a8c2', '#d48bb1', '#c47da5', '#9ab6e8', '#8bc0c8',
        '#e2a58b', '#cca473', '#9acfa1', '#b5a4db', '#d997a0'
      ];
      var hash = 0;
      var str = name || '';
      for (var i = 0; i < str.length; i++) {
        hash = str.charCodeAt(i) + ((hash << 5) - hash);
      }
      return colors[Math.abs(hash) % colors.length];
    }

    function formatRsvpDate(isoDate) {
      if (!isoDate) return '';
      try {
        var d = new Date(isoDate);
        if (isNaN(d.getTime())) return '';
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
        return d.getDate() + ' ' + months[d.getMonth()] + ' ' + d.getFullYear();
      } catch(e) {
        return '';
      }
    }

    function renderRsvpCards() {
      var grid = document.getElementById('rsvpCardsGrid');
      if (!grid) return;

      updateRsvpStatsAndTabs();

      var search = (document.getElementById('searchRsvp') ? document.getElementById('searchRsvp').value : '').toLowerCase().trim();

      var filtered = RSVP_LIST.filter(function(r){
        // Tab Filter
        var isVisible = r.is_visible !== 0;
        if (RSVP_ACTIVE_TAB === 'visible' && !isVisible) return false;
        if (RSVP_ACTIVE_TAB === 'hidden' && isVisible) return false;

        // Search Filter (nama, kota, ucapan)
        if (search) {
          var n = (r.name || '').toLowerCase();
          var c = (r.city || '').toLowerCase();
          var m = (r.message || '').toLowerCase();
          if (n.indexOf(search) === -1 && c.indexOf(search) === -1 && m.indexOf(search) === -1) {
            return false;
          }
        }
        return true;
      });

      if (filtered.length === 0) {
        grid.innerHTML = '<div class="rsvp-empty-state">' +
          '<p style="font-size:1.6rem;margin-bottom:8px">💌</p>' +
          '<strong style="font-size:1rem;color:var(--gold-soft)">Tidak ada ucapan atau konfirmasi yang sesuai</strong>' +
          '<p style="font-size:0.8rem;opacity:0.7;margin-top:4px">Coba ubah kata kunci pencarian atau filter tab.</p>' +
        '</div>';
        return;
      }

      var html = '';
      filtered.forEach(function(r){
        var isVisible = r.is_visible !== 0;
        var isHadir = (r.attendance || '').toLowerCase() === 'hadir';
        var firstLetter = (r.name || 'T').trim().charAt(0).toUpperCase();
        var avatarBg = getAvatarColor(r.name);
        var dateFormatted = formatRsvpDate(r.created_at);
        var cityMeta = (r.city ? escapeHtml(r.city) : '') + (r.city && dateFormatted ? ' · ' : '') + dateFormatted;
        if (!cityMeta) cityMeta = 'Tamu Undangan';

        var attBadge = isHadir
          ? '<span class="rsvp-badge-att rsvp-badge-hadir">Hadir (' + (r.pax || 1) + 'p)</span>'
          : '<span class="rsvp-badge-att rsvp-badge-berhalangan">Berhalangan</span>';

        var messageText = r.message ? escapeHtml(r.message) : '<em style="color:#94a3b8;font-size:0.85rem">Tidak menyertakan ucapan tertulis</em>';

        html += '<article class="rsvp-card" id="rsvp-card-' + r.id + '">' +
          // Header: Avatar + User Info + Attendance Badge
          '<div class="rsvp-card-header">' +
            '<div class="rsvp-avatar" style="background-color:' + avatarBg + '">' + firstLetter + '</div>' +
            '<div class="rsvp-user-info">' +
              '<div class="rsvp-user-name-row">' +
                '<h3 class="rsvp-user-name" title="' + escapeHtml(r.name) + '">' + escapeHtml(r.name) + '</h3>' +
                attBadge +
              '</div>' +
              '<div class="rsvp-user-meta">' + cityMeta + '</div>' +
            '</div>' +
          '</div>' +

          // Body: Pesan Ucapan
          '<div class="rsvp-card-body">' + messageText + '</div>' +

          // Footer: Switch Ditampilkan + 3 Action Icons (Balas WA, Download PNG, Hapus)
          '<div class="rsvp-card-footer">' +
            // On/Off Ditampilkan / Disembunyikan
            '<div class="switch-wrap">' +
              '<label class="switch-toggle" title="Aktifkan untuk menampilkan di web, matikan untuk menyembunyikan">' +
                '<input type="checkbox" id="switch-input-' + r.id + '" onchange="toggleWishVisibility(' + r.id + ', this.checked)"' + (isVisible ? ' checked' : '') + ' />' +
                '<span class="switch-slider"></span>' +
              '</label>' +
              '<span class="switch-label ' + (isVisible ? 'is-active' : 'is-hidden') + '" id="switch-label-' + r.id + '">' +
                (isVisible ? 'Ditampilkan' : 'Disembunyikan') +
              '</span>' +
            '</div>' +

            // Action Icons (Balas WA, Download PNG, Hapus)
            '<div class="rsvp-card-actions">' +
              // 1. Balas ke WhatsApp
              '<button type="button" class="rsvp-icon-btn btn-act-wa" onclick="replyWa(' + r.id + ')" title="Balas Ucapan ke WhatsApp">' +
                '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>' +
              '</button>' +
              // 2. Download JPG/PNG
              '<button type="button" class="rsvp-icon-btn btn-act-dl" onclick="downloadWishCard(' + r.id + ')" title="Download Kartu Ucapan (PNG)">' +
                '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>' +
              '</button>' +
              // 3. Hapus
              '<button type="button" class="rsvp-icon-btn btn-act-del" onclick="deleteRsvp(' + r.id + ')" title="Hapus Data RSVP Ini">' +
                '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>' +
              '</button>' +
            '</div>' +
          '</div>' +
        '</article>';
      });

      grid.innerHTML = html;
    }

    // Alias untuk backwards-compatibility
    var renderRsvpTable = renderRsvpCards;

    // 1. FITUR BALAS KE WA
    function replyWa(id) {
      var item = (RSVP_LIST || []).find(function(x){ return String(x.id) === String(id); });
      if (!item) return;

      // Cari nomor tamu di daftar tamu jika cocok namanya
      var matchedGuest = (GUEST_LIST || []).find(function(g){
        return (g.name || '').trim().toLowerCase() === (item.name || '').trim().toLowerCase();
      });
      var phone = matchedGuest && matchedGuest.phone ? matchedGuest.phone : '';

      if (!phone) {
        phone = prompt('Kirim balasan terima kasih ke WhatsApp ' + item.name + '.\nMasukkan nomor WhatsApp tujuan (contoh: 08123456789):', '');
        if (!phone) return;
      }

      phone = phone.replace(/[^0-9]/g, '');
      if (phone.startsWith('0')) {
        phone = '62' + phone.substring(1);
      }

      var text = "Assalamu'alaikum Wr. Wb.\n\n" +
        "Halo *" + item.name + "*,\n\n" +
        "Terima kasih banyak atas ucapan, doa restu, dan konfirmasi kehadirannya untuk pernikahan kami:\n" +
        "*Ahmad Nabil Kholili & Fadilatul Izza*\n\n" +
        (item.message ? ('_"' + item.message + '"_\n\n') : '') +
        "Semoga Allah SWT membalas segala ketulusan dan doa panjenengan dengan limpahan keberkahan, kesehatan, dan kebahagiaan berlipat ganda. Aamiin ya Rabbal 'Alamin. 🤲✨\n\n" +
        "Salam hangat,\n" +
        "*Nabil & Izza*";

      var waUrl = 'https://wa.me/' + phone + '?text=' + encodeURIComponent(text);
      window.open(waUrl, '_blank');
    }

    // 2. FITUR DOWNLOAD KARTU UCAPAN MENJADI PNG/JPG
    function downloadWishCard(id) {
      var cardEl = document.getElementById('rsvp-card-' + id);
      if (!cardEl) return;

      if (typeof html2canvas !== 'function') {
        alert('Modul download gambar sedang dimuat dari CDN. Silakan coba kembali sesaat lagi.');
        return;
      }

      showToast('Menyiapkan gambar kartu ucapan...');

      var footerEl = cardEl.querySelector('.rsvp-card-footer');
      var prevDisplay = footerEl ? footerEl.style.display : '';
      if (footerEl) footerEl.style.display = 'none';

      // Elemen watermark / header eksklusif kartu kenangan
      var exportBrand = document.createElement('div');
      exportBrand.className = 'export-watermark';
      exportBrand.innerHTML = '<div style="margin-top:16px;padding-top:10px;border-top:1px dashed #cbd5e1;display:flex;justify-content:space-between;align-items:center;font-size:0.75rem;color:#94a3b8;font-family:sans-serif;"><span>The Wedding of Nabil &amp; Izza</span><span>21 Januari 2027</span></div>';
      cardEl.appendChild(exportBrand);

      html2canvas(cardEl, {
        scale: 2.5,
        backgroundColor: '#ffffff',
        useCORS: true,
        logging: false
      }).then(function(canvas) {
        if (footerEl) footerEl.style.display = prevDisplay;
        if (exportBrand && exportBrand.parentNode) exportBrand.parentNode.removeChild(exportBrand);

        var item = (RSVP_LIST || []).find(function(x){ return String(x.id) === String(id); });
        var cleanName = (item && item.name ? item.name : 'Tamu').replace(/[^a-zA-Z0-9]/g, '_');
        var link = document.createElement('a');
        link.download = 'Ucapan_' + cleanName + '.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
        showToast('Kartu ucapan ' + cleanName + ' berhasil diunduh!');
      }).catch(function(err) {
        if (footerEl) footerEl.style.display = prevDisplay;
        if (exportBrand && exportBrand.parentNode) exportBrand.parentNode.removeChild(exportBrand);
        console.error('Gagal export kartu:', err);
        alert('Gagal mendownload kartu ucapan: ' + err.message);
      });
    }

    // 3. FITUR ON/OFF DITAMPILKAN / SEMBUNYIKAN
    function toggleWishVisibility(id, isChecked) {
      var item = (RSVP_LIST || []).find(function(x){ return String(x.id) === String(id); });
      if (item) {
        item.is_visible = isChecked ? 1 : 0;
      }

      var labelEl = document.getElementById('switch-label-' + id);
      if (labelEl) {
        labelEl.textContent = isChecked ? 'Ditampilkan' : 'Disembunyikan';
        labelEl.className = 'switch-label ' + (isChecked ? 'is-active' : 'is-hidden');
      }

      updateRsvpStatsAndTabs();

      fetch('/api/rsvps', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: Number(id), is_visible: isChecked ? 1 : 0 })
      })
      .then(function(res){
        if (!res.ok) throw new Error('Status: ' + res.status);
        return res.json();
      })
      .then(function(json){
        if (json && json.success) {
          showToast(isChecked ? 'Ucapan ditampilkan di web undangan' : 'Ucapan disembunyikan dari web undangan');
        } else {
          throw new Error(json.error || 'Gagal menyimpan perubahan');
        }
      })
      .catch(function(err){
        console.error('Gagal toggle visibilitas:', err);
        alert('Gagal mengubah status: ' + err.message);
        // Revert switch on error
        var switchInput = document.getElementById('switch-input-' + id);
        if (switchInput) switchInput.checked = !isChecked;
        if (item) item.is_visible = isChecked ? 0 : 1;
        if (labelEl) {
          labelEl.textContent = !isChecked ? 'Ditampilkan' : 'Disembunyikan';
          labelEl.className = 'switch-label ' + (!isChecked ? 'is-active' : 'is-hidden');
        }
        updateRsvpStatsAndTabs();
      });
    }

    // 4. FITUR HAPUS RSVP
    function deleteRsvp(id) {
      var item = (RSVP_LIST || []).find(function(x){ return String(x.id) === String(id); });
      var name = item ? item.name : 'tamu ini';
      if (!confirm('Apakah Anda yakin ingin menghapus konfirmasi RSVP dari ' + name + '?')) {
        return;
      }
      fetch('/api/rsvps?id=' + encodeURIComponent(id), {
        method: 'DELETE'
      })
      .then(function(res){
        if (!res.ok) throw new Error('Status: ' + res.status);
        return res.json();
      })
      .then(function(json){
        if (json && json.success) {
          showToast('RSVP ' + name + ' berhasil dihapus.');
          RSVP_LIST = RSVP_LIST.filter(function(r){ return String(r.id) !== String(id); });
          renderRsvpCards();
        } else {
          alert('Gagal menghapus: ' + (json.error || 'Terjadi kesalahan'));
        }
      })
      .catch(function(err){
        alert('Gagal menghapus RSVP: ' + err.message);
      });
    }

    function formatTimeAgo(isoDate) {
      if (!isoDate) return '-';
      try {
        var d = new Date(isoDate);
        if (isNaN(d.getTime())) return isoDate;
        var diff = Math.floor((Date.now() - d.getTime()) / 1000);
        if (diff < 60) return 'Baru saja';
        if (diff < 3600) return Math.floor(diff / 60) + ' mnt lalu';
        if (diff < 86400) return Math.floor(diff / 3600) + ' jam lalu';
        return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
      } catch(e) {
        return isoDate;
      }
    }

    function escapeHtml(str) {
      return (str || '').replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
      });
    }

    function showToast(msg) {
      var t = document.getElementById('toast');
      var m = document.getElementById('toastMsg');
      m.textContent = msg;
      t.classList.add('show');
      setTimeout(function(){ t.classList.remove('show'); }, 3000);
    }

    // Inisialisasi saat halaman dimuat
    document.addEventListener('DOMContentLoaded', checkAuth);
  </script>
</body>
</html>

