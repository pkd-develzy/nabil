    .rsvp-tab.active .tab-badge {
      color: var(--wine-950);
      font-weight: 700;
    }

    /* Cards Grid */
    .rsvp-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
      gap: 18px;
    }
    @media (max-width: 640px) {
