    /* Toast Notification */
    #toast {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      max-width: min(90vw, 420px);
      background: rgba(38, 6, 16, 0.95);
      border: 1.5px solid var(--gold);
      color: var(--gold-soft);
      padding: 12px 22px;
      border-radius: 999px;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7);
      font-size: 0.84rem;
      letter-spacing: 0.04em;
      z-index: 2000;
      opacity: 0;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 8px;
      pointer-events: none;
    }
    #toast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

