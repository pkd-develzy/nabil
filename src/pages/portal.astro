  <!-- SCRIPT LOGIKA PORTAL -->
  <script is:inline>
    // Konfigurasi Kunci Acara & State
    var PORTAL_AUTH_KEY = 'azluna_portal_auth_nabil';
    var GUESTS_STORAGE_KEY = 'azluna_guest_list_nabil';
    var CURRENT_CATEGORY = 'Umum';
    var CURRENT_TEMPLATE = 'formal';

    // 1. OTENTIKASI PENGANTIN
    function checkAuth() {
      var isAuth = localStorage.getItem(PORTAL_AUTH_KEY) === '1';
      if (isAuth) {
        document.getElementById('loginModal').classList.add('hidden');
        document.getElementById('portalContent').classList.remove('hidden');
        renderGuestTable();
        updateMessagePreview();
        fetchGuestsFromD1();
      } else {
        document.getElementById('loginModal').classList.remove('hidden');
        document.getElementById('portalContent').classList.add('hidden');
      }
    }

    function togglePasswordVisibility() {
      var input = document.getElementById('loginPass');
      var eyeOpen = document.getElementById('eyeOpen');
      var eyeClosed = document.getElementById('eyeClosed');
      if (!input) return;
      if (input.type === 'password') {
        input.type = 'text';
        if (eyeOpen) eyeOpen.style.display = 'none';
        if (eyeClosed) eyeClosed.style.display = 'block';
      } else {
        input.type = 'password';
        if (eyeOpen) eyeOpen.style.display = 'block';
        if (eyeClosed) eyeClosed.style.display = 'none';
      }
    }

    function handleLogin(e) {
      e.preventDefault();
      var pass = document.getElementById('loginPass').value.trim();
      var err = document.getElementById('loginError');
      if (pass === 'Izza-Nabil2027') {
        localStorage.setItem(PORTAL_AUTH_KEY, '1');
        err.style.display = 'none';
        checkAuth();
        showToast('Selamat datang di Portal Pengantin!');
      } else {
        err.style.display = 'block';
        var box = document.querySelector('.login-box');
        box.style.animation = 'none';
        box.offsetHeight;
        box.style.animation = 'modalFadeIn 0.3s ease';
      }
      return false;
    }

    function handleLogout() {
      if (confirm('Apakah Anda ingin keluar dari portal?')) {
        localStorage.removeItem(PORTAL_AUTH_KEY);
        location.reload();
      }
    }

    // 2. KELOLA DATA TAMU DI LOCALSTORAGE & CLOUDFLARE D1
    function getStoredGuests() {
      try {
        var data = localStorage.getItem(GUESTS_STORAGE_KEY);
        return data ? JSON.parse(data) : [];
      } catch(e) { return []; }
    }

    function saveStoredGuests(list) {
      try {
        localStorage.setItem(GUESTS_STORAGE_KEY, JSON.stringify(list));
      } catch(e) {}
      renderGuestTable();
    }

    // Mengambil daftar tamu terbaru dari Cloudflare D1
    function fetchGuestsFromD1() {
      fetch('/api/guests')
        .then(function(res) {
          if (!res.ok) throw new Error('Status: ' + res.status);
          return res.json();
        })
        .then(function(res) {
          if (res && res.success && Array.isArray(res.data)) {
            var formatted = res.data.map(function(item) {
              return {
                id: String(item.id),
                name: item.name,
                phone: item.phone || '',
                category: item.category || 'Umum',
                sent: !!item.sent,
                createdAt: item.created_at || new Date().toISOString()
              };
            });
            saveStoredGuests(formatted);
          }
        })
        .catch(function(err) {
          console.warn('Gagal sinkronisasi data D1 (menggunakan data lokal):', err);
        });
    }

    // 3. GENERATOR LINK & TEMPLATE PESAN
    function getBaseUrl() {
      return window.location.origin + '/';
    }

    function buildGuestUrl(name) {
      var clean = (name || '').trim();
      if (!clean) return getBaseUrl();
      return getBaseUrl() + '?to=' + encodeURIComponent(clean);
    }

    function formatWhatsAppNumber(phone) {
      if (!phone) return '';
      var clean = phone.replace(/[^0-9]/g, '');
      if (clean.indexOf('08') === 0) {
        clean = '628' + clean.slice(2);
      } else if (clean.indexOf('8') === 0 && clean.length >= 9) {
        clean = '628' + clean.slice(1);
      }
      return clean;
    }

    function generateMessage(name, link, style) {
      var guestName = name ? name.trim() : '[Nama Tamu]';
      var inviteLink = link || buildGuestUrl(name);

      if (style === 'santai') {
        return "Halo " + guestName + "!\n\n" +
          "Kabar bahagia! Insya Allah kami akan melangsungkan pernikahan:\n\n" +
          "💍 Ahmad Nabil Kholili & Fadilatul Izza\n" +
          "📅 Kamis, 21 Januari 2027\n\n" +
          "Kami sangat berharap kehadiranmu untuk merayakan momen bahagia ini bersama kami. Informasi lengkap acara dan ucapan bisa dibuka lewat link undangan berikut:\n\n" +
          inviteLink + "\n\n" +
          "Sampai jumpa di hari bahagia kami!\n\n" +
          "— Nabil & Izza";
      }

      if (style === 'keluarga') {
        return "Assalamu'alaikum Warahmatullahi Wabarakatuh.\n\n" +
          "Kepada Yth. Keluarga Tercinta:\n" +
          guestName + "\n\n" +
          "Dengan memohon rahmat dan ridho Allah SWT, kami bermaksud mengundang sanak saudara sekalian dalam acara walimatul 'urs putra-putri kami:\n\n" +
          "Ahmad Nabil Kholili & Fadilatul Izza\n" +
          "Hari/Tgl: Kamis, 21 Januari 2027\n" +
          "Lokasi: Brebes, Jawa Tengah\n\n" +
          "Detail rangkaian acara serta doa restu dapat diakses melalui tautan undangan digital di bawah ini:\n\n" +
          inviteLink + "\n\n" +
          "Kehadiran serta doa restu dari Bapak/Ibu/Saudara/i merupakan kebahagiaan dan kehormatan besar bagi keluarga kami.\n\n" +
          "Wassalamu'alaikum Warahmatullahi Wabarakatuh.\n\n" +
          "Keluarga Besar Bpk. Shobirin & Bpk. Rosihin\n" +
          "Nabil & Izza";
      }

      // Default: Formal & Sopan
      return "Kepada Yth.\n" +
        "Bapak/Ibu/Saudara/i " + guestName + "\n\n" +
        "Assalamu'alaikum Warahmatullahi Wabarakatuh.\n\n" +
        "Tanpa mengurangi rasa hormat, perkenankan kami mengundang Bapak/Ibu/Saudara/i untuk menghadiri acara pernikahan kami:\n\n" +
        "Ahmad Nabil Kholili, S.Ag.\n" +
        "&\n" +
        "Fadilatul Izza\n\n" +
        "Yang insya Allah akan dilaksanakan pada:\n" +
        "Hari/Tanggal: Kamis, 21 Januari 2027\n" +
        "Tempat: Brebes, Jawa Tengah\n\n" +
        "Informasi lengkap mengenai jadwal akad, resepsi, dan peta lokasi dapat dilihat melalui tautan undangan resmi berikut:\n\n" +
        inviteLink + "\n\n" +
        "Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir untuk memberikan doa restu kepada kedua mempelai.\n\n" +
        "Wassalamu'alaikum Warahmatullahi Wabarakatuh.\n\n" +
        "Hormat kami,\n" +
        "Nabil & Izza";
    }

    function updateMessagePreview() {
      var name = document.getElementById('guestName').value;
      var link = buildGuestUrl(name);
      document.getElementById('linkPreview').value = link;
      var msg = generateMessage(name, link, CURRENT_TEMPLATE);
      document.getElementById('messagePreview').value = msg;
    }

    function selectCategory(btn) {
      document.querySelectorAll('#categoryGroup .pill-btn').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      CURRENT_CATEGORY = btn.getAttribute('data-cat');
    }

    function selectTemplate(btn) {
      document.querySelectorAll('#templateGroup .pill-btn').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      CURRENT_TEMPLATE = btn.getAttribute('data-tpl');
      updateMessagePreview();
    }

    // 4. AKSI PENGIRIMAN & CLIPBOARD
    function sendWhatsAppNow() {
      var name = document.getElementById('guestName').value.trim();
      var phone = formatWhatsAppNumber(document.getElementById('guestPhone').value.trim());
      var msg = document.getElementById('messagePreview').value.trim();

      if (!name) {
        alert('Mohon masukkan nama tamu undangan terlebih dahulu.');
        document.getElementById('guestName').focus();
        return;
      }

      // Auto save or update status
      markOrAddGuest(name, phone, CURRENT_CATEGORY, true);

      var url = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(msg);
      if (phone) {
        url = 'https://api.whatsapp.com/send?phone=' + phone + '&text=' + encodeURIComponent(msg);
      }
      window.open(url, '_blank');
      showToast('Membuka WhatsApp untuk ' + name);
    }

    function copyToClipboard(text, successMsg) {
      if (!text) return;
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(function(){
          showToast(successMsg);
        }).catch(function(){
          fallbackCopy(text, successMsg);
        });
      } else {
        fallbackCopy(text, successMsg);
      }
    }

    function fallbackCopy(text, successMsg) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.left = '-9999px';
      ta.style.top = '0';
      ta.setAttribute('readonly', '');
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try {
        var ok = document.execCommand('copy');
        if (ok) showToast(successMsg);
        else alert('Silakan salin teks manual:\n' + text);
      } catch (err) {
        prompt('Silakan salin manual:', text);
      }
      document.body.removeChild(ta);
    }

    function copyFullMessage() {
      var msg = document.getElementById('messagePreview').value;
      if (!msg) return;
      copyToClipboard(msg, 'Teks pesan WhatsApp berhasil disalin!');
    }

    function copyLinkOnly() {
      var link = document.getElementById('linkPreview').value;
      if (!link) return;
      copyToClipboard(link, 'Tautan undangan berhasil disalin!');
    }

    function markOrAddGuest(name, phone, category, isSent) {
      var list = getStoredGuests();
      var found = list.find(function(g){ return g.name.toLowerCase() === name.toLowerCase(); });
      var targetGuest = null;

      if (found) {
        if (phone) found.phone = phone;
        if (category) found.category = category;
        if (isSent !== undefined) found.sent = !!isSent;
        targetGuest = found;
      } else {
        targetGuest = {
          id: Date.now().toString(),
          name: name,
          phone: phone,
          category: category || 'Umum',
          sent: !!isSent,
          createdAt: new Date().toISOString()
        };
        list.unshift(targetGuest);
      }
      saveStoredGuests(list);

      // Sinkronkan ke Cloudflare D1
      if (targetGuest) {
        fetch('/api/guests', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: targetGuest.id,
            name: targetGuest.name,
            category: targetGuest.category,
            phone: targetGuest.phone,
            sent: targetGuest.sent ? 1 : 0
          })
        }).catch(function(err){
          console.warn('Gagal sync tamu ke Cloudflare D1:', err);
        });
      }
    }

    function saveGuest() {
      var name = document.getElementById('guestName').value.trim();
      var phone = formatWhatsAppNumber(document.getElementById('guestPhone').value.trim());
      if (!name) {
        alert('Mohon masukkan nama tamu undangan.');
        document.getElementById('guestName').focus();
        return;
      }
      markOrAddGuest(name, phone, CURRENT_CATEGORY, false);
      showToast('Tamu ' + name + ' berhasil disimpan!');
      resetForm();
    }

    function resetForm() {
      document.getElementById('guestName').value = '';
      document.getElementById('guestPhone').value = '';
      updateMessagePreview();
    }

    // 5. RENDER DAFTAR TAMU & STATISTIK
    function renderGuestTable() {
      var list = getStoredGuests();
      var tbody = document.getElementById('guestTableBody');
      var search = (document.getElementById('searchGuest').value || '').toLowerCase().trim();
      var filterCat = document.getElementById('filterCategory').value;
      var filterSt = document.getElementById('filterStatus').value;

      // Hitung Statistik
      var total = list.length;
      var sent = list.filter(function(g){ return g.sent; }).length;
      var unsent = total - sent;
      var vip = list.filter(function(g){ return g.category === 'VIP' || g.category === 'Keluarga'; }).length;

      document.getElementById('statTotal').textContent = total;
      document.getElementById('statSent').textContent = sent;
      document.getElementById('statUnsent').textContent = unsent;
      document.getElementById('statVip').textContent = vip;

      // Filter
      var filtered = list.filter(function(g){
        var matchName = !search || g.name.toLowerCase().indexOf(search) !== -1;
        var matchCat = filterCat === 'ALL' || g.category === filterCat;
        var matchSt = filterSt === 'ALL' || (filterSt === 'sent' && g.sent) || (filterSt === 'unsent' && !g.sent);
        return matchName && matchCat && matchSt;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:32px;color:rgba(242,224,190,0.6)">Belum ada data tamu yang sesuai.</td></tr>';
        return;
      }

      var html = '';
      filtered.forEach(function(g, idx){
        var link = buildGuestUrl(g.name);
        var statusBadge = g.sent ?
          '<span class="badge badge-sent" title="Klik untuk ubah status" onclick="toggleSentStatus(\'' + g.id + '\')">✓ Terkirim</span>' :
          '<span class="badge badge-unsent" title="Klik untuk ubah status" onclick="toggleSentStatus(\'' + g.id + '\')">&bull; Belum Kirim</span>';

        html += '<tr class="guest-row">' +
          '<td class="td-num" style="color:rgba(242,224,190,0.6)">' + (idx + 1) + '</td>' +
          '<td class="td-name">' +
            '<div>' +
              '<strong class="guest-name-text">' + escapeHtml(g.name) + '</strong>' +
              '<span class="badge badge-cat">' + escapeHtml(g.category) + '</span>' +
            '</div>' +
          '</td>' +
          '<td class="td-phone">' +
            '<span class="mobile-label">WhatsApp:</span>' +
            (g.phone ? '<a href="tel:' + g.phone + '" style="color:var(--gold-soft);text-decoration:none;font-weight:500">' + g.phone + '</a>' : '<span style="opacity:0.4">Tanpa Nomor</span>') +
          '</td>' +
          '<td class="td-status">' +
            '<span class="mobile-label">Status:</span>' + statusBadge +
          '</td>' +
          '<td class="td-actions">' +
            '<div class="action-btn-group">' +
              '<button type="button" class="btn btn-wa btn-sm" onclick="quickSendWA(\'' + g.id + '\')" title="Kirim via WhatsApp">Kirim WA</button>' +
              '<button type="button" class="btn btn-outline btn-sm" onclick="quickCopyLink(\'' + g.id + '\')" title="Salin Tautan">Link</button>' +
              '<a href="' + link + '" target="_blank" class="btn btn-outline btn-sm" title="Buka Undangan">Buka</a>' +
              '<button type="button" class="btn btn-outline btn-sm" style="border-color:#ff5277;color:#ff859d" onclick="deleteGuest(\'' + g.id + '\')" title="Hapus">✕</button>' +
            '</div>' +
          '</td>' +
        '</tr>';
      });
      tbody.innerHTML = html;
    }

    function toggleSentStatus(id) {
      var list = getStoredGuests();
      var item = list.find(function(g){ return g.id === id; });
      if (item) {
        item.sent = !item.sent;
        saveStoredGuests(list);
        // Sync ke Cloudflare D1
        fetch('/api/guests', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: item.id,
            name: item.name,
            category: item.category,
            phone: item.phone,
            sent: item.sent ? 1 : 0
          })
        }).catch(function(e){});
      }
    }

    function quickSendWA(id) {
      var list = getStoredGuests();
      var item = list.find(function(g){ return g.id === id; });
      if (!item) return;
      var link = buildGuestUrl(item.name);
      var msg = generateMessage(item.name, link, CURRENT_TEMPLATE);
      var url = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(msg);
      if (item.phone) {
        url = 'https://api.whatsapp.com/send?phone=' + item.phone + '&text=' + encodeURIComponent(msg);
      }
      item.sent = true;
      saveStoredGuests(list);
      // Sync status terkirim ke D1
      fetch('/api/guests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: item.id,
          name: item.name,
          category: item.category,
          phone: item.phone,
          sent: 1
        })
      }).catch(function(e){});

      window.open(url, '_blank');
      showToast('Membuka WhatsApp untuk ' + item.name);
    }

    function quickCopyLink(id) {
      var list = getStoredGuests();
      var item = list.find(function(g){ return g.id === id; });
      if (!item) return;
      var link = buildGuestUrl(item.name);
      copyToClipboard(link, 'Link undangan ' + item.name + ' berhasil disalin!');
    }

    function deleteGuest(id) {
      if (confirm('Hapus tamu ini dari daftar?')) {
        var list = getStoredGuests().filter(function(g){ return g.id !== id; });
        saveStoredGuests(list);
        showToast('Tamu telah dihapus.');
        // Hapus dari Cloudflare D1
        fetch('/api/guests?id=' + encodeURIComponent(id), {
          method: 'DELETE'
        }).catch(function(err){
          console.warn('Gagal menghapus dari D1:', err);
        });
      }
    }

    function clearAllGuests() {
      if (confirm('PERINGATAN: Apakah Anda yakin ingin menghapus SEMUA daftar tamu?')) {
        localStorage.removeItem(GUESTS_STORAGE_KEY);
        renderGuestTable();
        showToast('Semua tamu berhasil dibersihkan.');
      }
    }

    function exportRecapText() {
      var list = getStoredGuests();
      if (!list.length) {
        alert('Daftar tamu masih kosong.');
        return;
      }
      var text = "REKAPITULASI TAMU UNDANGAN NABIL & IZZA\n";
      text += "Total: " + list.length + " Tamu\n\n";
      list.forEach(function(g, i){
        var st = g.sent ? '[SUDAH TERKIRIM]' : '[BELUM KIRIM]';
        text += (i + 1) + ". " + g.name + " (" + g.category + ") " + st + "\n";
        text += "   Link: " + buildGuestUrl(g.name) + "\n";
        if (g.phone) text += "   WA: " + g.phone + "\n";
        text += "\n";
      });
      copyToClipboard(text, 'Rekapitulasi seluruh tamu berhasil disalin!');
    }

    function escapeHtml(str) {
      return (str || '').replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
      });
    }

    function showToast(msg) {
      var t = document.getElementById('toast');
      var m = document.getElementById('toastMsg');
      m.textContent = msg;
      t.classList.add('show');
      setTimeout(function(){ t.classList.remove('show'); }, 3000);
    }

    // Inisialisasi saat halaman dimuat
    document.addEventListener('DOMContentLoaded', checkAuth);
  </script>
</body>
</html>

