    function toggleSentStatus(id) {
      var list = getStoredGuests();
      var item = list.find(function(g){ return g.id === id; });
      if (item) {
        item.sent = !item.sent;
        saveStoredGuests(list);
        // Sync ke Cloudflare D1
        fetch('/api/guests', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: item.id,
            name: item.name,
            category: item.category,
            phone: item.phone,
            sent: item.sent ? 1 : 0
          })
        }).catch(function(e){});
      }
    }

    function quickSendWA(id) {
      var list = getStoredGuests();
      var item = list.find(function(g){ return g.id === id; });
      if (!item) return;
      var link = buildGuestUrl(item.name, item.category);
      var msg = generateMessage(item.name, link, CURRENT_TEMPLATE);
      var url = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(msg);
      if (item.phone) {
        url = 'https://api.whatsapp.com/send?phone=' + item.phone + '&text=' + encodeURIComponent(msg);
      }
      item.sent = true;
      saveStoredGuests(list);
      // Sync status terkirim ke D1
      fetch('/api/guests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: item.id,
          name: item.name,
          category: item.category,
          phone: item.phone,
          sent: 1
        })
      }).catch(function(e){});

      window.open(url, '_blank');
      showToast('Membuka WhatsApp untuk ' + item.name);
    }

    function quickCopyLink(id) {
      var list = getStoredGuests();
      var item = list.find(function(g){ return g.id === id; });
      if (!item) return;
      var link = buildGuestUrl(item.name, item.category);
      copyToClipboard(link, 'Link undangan ' + item.name + ' berhasil disalin!');
    }

    function deleteGuest(id) {
      var list = getStoredGuests();
      var item = list.find(function(g){ return g.id === id; });
      var name = item ? item.name : 'tamu ini';

      appConfirm('Apakah Anda yakin ingin menghapus "' + name + '" dari daftar tamu undangan?', 'Hapus Tamu', 'danger', 'Ya, Hapus', 'Batal')
        .then(function(confirmed) {
          if (!confirmed) return;
          var updated = getStoredGuests().filter(function(g){ return g.id !== id; });
          saveStoredGuests(updated);
          showToast('Tamu ' + name + ' telah dihapus.');
          renderGuestTable();
          // Hapus dari Cloudflare D1
          fetch('/api/guests?id=' + encodeURIComponent(id), {
            method: 'DELETE'
          }).catch(function(err){
            console.warn('Gagal menghapus dari D1:', err);
          });
        });
    }

    function clearAllGuests() {
      var list = getStoredGuests();
      if (!list.length) {
        appAlert('Daftar tamu saat ini masih kosong.', 'Daftar Kosong', 'info');
        return;
      }
      appConfirm('PERINGATAN: Apakah Anda yakin ingin menghapus SEMUA data tamu undangan? Tindakan ini permanen dan tidak dapat dibatalkan.', 'Hapus Semua Tamu', 'danger', 'Hapus Semua', 'Batal')
        .then(function(confirmed) {
          if (!confirmed) return;
          localStorage.removeItem(GUESTS_STORAGE_KEY);
          renderGuestTable();
          showToast('Semua tamu berhasil dibersihkan.');
          fetch('/api/guests?all=1', { method: 'DELETE' }).catch(function(err){
            console.warn('Gagal menghapus semua tamu dari D1:', err);
          });
        });
    }

    function exportRecapText() {
      var list = getStoredGuests();
      if (!list.length) {
        appAlert('Daftar tamu saat ini masih kosong.', 'Daftar Kosong', 'info');
        return;
      }
      var text = "REKAPITULASI TAMU UNDANGAN NABIL & IZZA\n";
      text += "Total: " + list.length + " Tamu\n\n";
      list.forEach(function(g, i){
        var st = g.sent ? '[SUDAH TERKIRIM]' : '[BELUM KIRIM]';
        text += (i + 1) + ". " + g.name + " (" + g.category + ") " + st + "\n";
        text += "   Link: " + buildGuestUrl(g.name, g.category) + "\n";
        if (g.phone) text += "   WA: " + g.phone + "\n";
        text += "\n";
      });
      copyToClipboard(text, 'Rekapitulasi seluruh tamu berhasil disalin!');
    }

    // 6. LOGIKA REKAPITULASI RSVP DARI CLOUDFLARE D1 (CARD GRID SYSTEM)
    var RSVP_LIST = [];
    var RSVP_ACTIVE_TAB = 'all';

    function fetchRsvpsFromD1(showToastMsg) {
      fetch('/api/rsvps?admin=1')
        .then(function(res){
          if (!res.ok) throw new Error('Status: ' + res.status);
          return res.json();
        })
        .then(function(json){
          if (json && json.success && Array.isArray(json.data)) {
            RSVP_LIST = json.data;
            renderRsvpCards();
            if (showToastMsg) showToast('Data RSVP berhasil diperbarui!');
          }
        })
        .catch(function(err){
          console.warn('Gagal memuat data RSVP dari D1:', err);
        });
    }

    function setRsvpFilterTab(tab) {
      RSVP_ACTIVE_TAB = tab;
      var tabs = ['all', 'visible', 'hidden'];
      tabs.forEach(function(t) {
        var el = document.getElementById(t === 'all' ? 'tabRsvpAll' : (t === 'visible' ? 'tabRsvpVisible' : 'tabRsvpHidden'));
        if (el) {
          if (t === tab) el.classList.add('active');
          else el.classList.remove('active');
        }
      });
      renderRsvpCards();
    }

    function updateRsvpStatsAndTabs() {
      var hadirList = RSVP_LIST.filter(function(r){ return (r.attendance || '').toLowerCase() === 'hadir'; });
      var totalPax = hadirList.reduce(function(acc, r){ return acc + (parseInt(r.pax, 10) || 1); }, 0);
      var statHadirEl = document.getElementById('statRsvpHadir');
      var statTotalEl = document.getElementById('statRsvpTotal');
      if (statHadirEl) statHadirEl.textContent = totalPax + ' Org';
      if (statTotalEl) statTotalEl.textContent = RSVP_LIST.length;

      var visibleCount = RSVP_LIST.filter(function(r){ return r.is_visible !== 0; }).length;
      var hiddenCount = RSVP_LIST.filter(function(r){ return r.is_visible === 0; }).length;

      var tabAllEl = document.getElementById('tabCountAll');
      var tabVisEl = document.getElementById('tabCountVisible');
      var tabHidEl = document.getElementById('tabCountHidden');
      var navBadgeRsvps = document.getElementById('navBadgeRsvps');

      if (tabAllEl) tabAllEl.textContent = RSVP_LIST.length;
      if (tabVisEl) tabVisEl.textContent = visibleCount;
      if (tabHidEl) tabHidEl.textContent = hiddenCount;
      if (navBadgeRsvps) navBadgeRsvps.textContent = RSVP_LIST.length;
    }

    function getAvatarColor(name) {
      var colors = [
        '#e5a8c2', '#d48bb1', '#c47da5', '#9ab6e8', '#8bc0c8',
        '#e2a58b', '#cca473', '#9acfa1', '#b5a4db', '#d997a0'
      ];
      var hash = 0;
      var str = name || '';
      for (var i = 0; i < str.length; i++) {
        hash = str.charCodeAt(i) + ((hash << 5) - hash);
      }
      return colors[Math.abs(hash) % colors.length];
    }

    function formatRsvpDate(isoDate) {
      if (!isoDate) return '';
      try {
        var d = new Date(isoDate);
        if (isNaN(d.getTime())) return '';
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
        return d.getDate() + ' ' + months[d.getMonth()] + ' ' + d.getFullYear();
      } catch(e) {
        return '';
      }
    }

    function renderRsvpCards() {
      var grid = document.getElementById('rsvpCardsGrid');
      if (!grid) return;

      updateRsvpStatsAndTabs();

      var search = (document.getElementById('searchRsvp') ? document.getElementById('searchRsvp').value : '').toLowerCase().trim();

      var filtered = RSVP_LIST.filter(function(r){
        // Tab Filter
        var isVisible = r.is_visible !== 0;
        if (RSVP_ACTIVE_TAB === 'visible' && !isVisible) return false;
        if (RSVP_ACTIVE_TAB === 'hidden' && isVisible) return false;

        // Search Filter (nama, kota, ucapan)
        if (search) {
          var n = (r.name || '').toLowerCase();
          var c = (r.city || '').toLowerCase();
          var m = (r.message || '').toLowerCase();
          if (n.indexOf(search) === -1 && c.indexOf(search) === -1 && m.indexOf(search) === -1) {
            return false;
          }
        }
        return true;
      });

      if (filtered.length === 0) {
        grid.innerHTML = '<div class="rsvp-empty-state">' +
          '<p style="font-size:1.6rem;margin-bottom:8px">💌</p>' +
          '<strong style="font-size:1rem;color:var(--gold-soft)">Tidak ada ucapan atau konfirmasi yang sesuai</strong>' +
          '<p style="font-size:0.8rem;opacity:0.7;margin-top:4px">Coba ubah kata kunci pencarian atau filter tab.</p>' +
