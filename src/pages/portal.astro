            '</div>' +

            // Action Icons (Balas WA, Download PNG, Hapus)
            '<div class="rsvp-card-actions">' +
              // 1. Balas ke WhatsApp
              '<button type="button" class="rsvp-icon-btn btn-act-wa" onclick="replyWa(' + r.id + ')" title="Balas Ucapan ke WhatsApp">' +
                '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>' +
              '</button>' +
              // 2. Download JPG/PNG
              '<button type="button" class="rsvp-icon-btn btn-act-dl" onclick="downloadWishCard(' + r.id + ')" title="Download Kartu Ucapan (PNG)">' +
                '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>' +
              '</button>' +
              // 3. Hapus
              '<button type="button" class="rsvp-icon-btn btn-act-del" onclick="deleteRsvp(' + r.id + ')" title="Hapus Data RSVP Ini">' +
                '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>' +
              '</button>' +
            '</div>' +
          '</div>' +
        '</article>';
      });

      grid.innerHTML = html;
    }

    // Alias untuk backwards-compatibility
    var renderRsvpTable = renderRsvpCards;

    // 1. FITUR BALAS KE WA
    function replyWa(id) {
      var item = (RSVP_LIST || []).find(function(x){ return String(x.id) === String(id); });
      if (!item) return;

      var matchedGuest = (GUEST_LIST || []).find(function(g){
        return (g.name || '').trim().toLowerCase() === (item.name || '').trim().toLowerCase();
      });
      var phone = matchedGuest && matchedGuest.phone ? matchedGuest.phone : '';

      if (!phone) {
        appPrompt('Kirim balasan terima kasih ke WhatsApp ' + item.name + '.\nMasukkan nomor WhatsApp tujuan (contoh: 08123456789):', '08', 'Balas WhatsApp')
          .then(function(inputPhone) {
            if (!inputPhone) return;
            executeSendWaReply(inputPhone, item);
          });
        return;
      }

      executeSendWaReply(phone, item);
    }

    function executeSendWaReply(rawPhone, item) {
      var phone = rawPhone.replace(/[^0-9]/g, '');
      if (phone.startsWith('0')) {
        phone = '62' + phone.substring(1);
      }

      var text = "Assalamu'alaikum Wr. Wb.\n\n" +
        "Halo *" + item.name + "*,\n\n" +
        "Terima kasih banyak atas ucapan, doa restu, dan konfirmasi kehadirannya untuk pernikahan kami:\n" +
        "*Ahmad Nabil Kholili & Fadilatul Izza*\n\n" +
        (item.message ? ('_"' + item.message + '"_\n\n') : '') +
        "Semoga Allah SWT membalas segala ketulusan dan doa panjenengan dengan limpahan keberkahan, kesehatan, dan kebahagiaan berlipat ganda. Aamiin ya Rabbal 'Alamin. 🤲\n\n" +
        "Salam hangat,\n" +
        "*Nabil & Izza*";

      var waUrl = 'https://wa.me/' + phone + '?text=' + encodeURIComponent(text);
      window.open(waUrl, '_blank');
    }

    // 2. FITUR DOWNLOAD KARTU UCAPAN MENJADI PNG/JPG
    function downloadWishCard(id) {
      var cardEl = document.getElementById('rsvp-card-' + id);
      if (!cardEl) return;

      if (typeof html2canvas !== 'function') {
        appAlert('Modul download gambar sedang dimuat dari CDN. Silakan coba kembali sesaat lagi.', 'Menyiapkan Gambar', 'info');
        return;
      }

      showToast('Menyiapkan gambar kartu ucapan...');

      var footerEl = cardEl.querySelector('.rsvp-card-footer');
      var prevDisplay = footerEl ? footerEl.style.display : '';
      if (footerEl) footerEl.style.display = 'none';

      // Elemen watermark / header eksklusif kartu kenangan tema royal
      var exportBrand = document.createElement('div');
      exportBrand.className = 'export-watermark';
      exportBrand.innerHTML = '<div style="margin-top:16px;padding-top:12px;border-top:1px dashed rgba(201,165,107,0.4);display:flex;justify-content:space-between;align-items:center;font-size:0.75rem;color:var(--gold-soft);font-family:\'Cinzel\',serif;letter-spacing:0.04em;"><span>The Wedding of Nabil &amp; Izza</span><span>21 Januari 2027</span></div>';
      cardEl.appendChild(exportBrand);

      html2canvas(cardEl, {
        scale: 2.5,
        backgroundColor: '#260610',
        useCORS: true,
        logging: false
      }).then(function(canvas) {
        if (footerEl) footerEl.style.display = prevDisplay;
        if (exportBrand && exportBrand.parentNode) exportBrand.parentNode.removeChild(exportBrand);

        var item = (RSVP_LIST || []).find(function(x){ return String(x.id) === String(id); });
        var cleanName = (item && item.name ? item.name : 'Tamu').replace(/[^a-zA-Z0-9]/g, '_');
        var link = document.createElement('a');
        link.download = 'Ucapan_' + cleanName + '.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
        showToast('Kartu ucapan ' + cleanName + ' berhasil diunduh!');
      }).catch(function(err) {
        if (footerEl) footerEl.style.display = prevDisplay;
        if (exportBrand && exportBrand.parentNode) exportBrand.parentNode.removeChild(exportBrand);
        console.error('Gagal export kartu:', err);
        appAlert('Gagal mendownload kartu ucapan: ' + err.message, 'Gagal Download', 'warning');
      });
    }

    // 3. FITUR ON/OFF DITAMPILKAN / SEMBUNYIKAN
    function toggleWishVisibility(id, isChecked) {
      var item = (RSVP_LIST || []).find(function(x){ return String(x.id) === String(id); });
      if (item) {
        item.is_visible = isChecked ? 1 : 0;
      }

      var labelEl = document.getElementById('switch-label-' + id);
      if (labelEl) {
        labelEl.textContent = isChecked ? 'Ditampilkan' : 'Disembunyikan';
        labelEl.className = 'switch-label ' + (isChecked ? 'is-active' : 'is-hidden');
      }

      updateRsvpStatsAndTabs();

      fetch('/api/rsvps', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: Number(id), is_visible: isChecked ? 1 : 0 })
      })
      .then(function(res){
        if (!res.ok) throw new Error('Status: ' + res.status);
        return res.json();
      })
      .then(function(json){
        if (json && json.success) {
          showToast(isChecked ? 'Ucapan ditampilkan di web undangan' : 'Ucapan disembunyikan dari web undangan');
        } else {
          throw new Error(json.error || 'Gagal menyimpan perubahan');
        }
      })
      .catch(function(err){
        console.error('Gagal toggle visibilitas:', err);
        appAlert('Gagal mengubah status: ' + err.message, 'Gagal Mengubah Status', 'warning');
        // Revert switch on error
        var switchInput = document.getElementById('switch-input-' + id);
        if (switchInput) switchInput.checked = !isChecked;
        if (item) item.is_visible = isChecked ? 0 : 1;
        if (labelEl) {
          labelEl.textContent = !isChecked ? 'Ditampilkan' : 'Disembunyikan';
          labelEl.className = 'switch-label ' + (!isChecked ? 'is-active' : 'is-hidden');
        }
        updateRsvpStatsAndTabs();
      });
    }

    // 4. FITUR HAPUS RSVP
    function deleteRsvp(id) {
      var item = (RSVP_LIST || []).find(function(x){ return String(x.id) === String(id); });
      var name = item ? item.name : 'tamu ini';

      appConfirm('Apakah Anda yakin ingin menghapus konfirmasi RSVP & doa dari "' + name + '"?', 'Hapus RSVP & Ucapan', 'danger', 'Ya, Hapus', 'Batal')
        .then(function(confirmed) {
          if (!confirmed) return;
          fetch('/api/rsvps?id=' + encodeURIComponent(id), {
            method: 'DELETE'
          })
          .then(function(res){
            if (!res.ok) throw new Error('Status: ' + res.status);
            return res.json();
          })
          .then(function(json){
            if (json && json.success) {
              showToast('RSVP ' + name + ' berhasil dihapus.');
              RSVP_LIST = RSVP_LIST.filter(function(r){ return String(r.id) !== String(id); });
              renderRsvpCards();
            } else {
              appAlert('Gagal menghapus: ' + (json.error || 'Terjadi kesalahan'), 'Gagal Menghapus', 'warning');
            }
          })
          .catch(function(err){
            appAlert('Gagal menghapus RSVP: ' + err.message, 'Gagal Menghapus', 'warning');
          });
        });
    }

    function formatTimeAgo(isoDate) {
      if (!isoDate) return '-';
      try {
        var d = new Date(isoDate);
        if (isNaN(d.getTime())) return isoDate;
        var diff = Math.floor((Date.now() - d.getTime()) / 1000);
        if (diff < 60) return 'Baru saja';
        if (diff < 3600) return Math.floor(diff / 60) + ' mnt lalu';
        if (diff < 86400) return Math.floor(diff / 3600) + ' jam lalu';
        return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
      } catch(e) {
        return isoDate;
      }
    }

    function escapeHtml(str) {
      return (str || '').replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
      });
    }

    function showToast(msg) {
      var t = document.getElementById('toast');
      var m = document.getElementById('toastMsg');
      m.textContent = msg;
      t.classList.add('show');
      setTimeout(function(){ t.classList.remove('show'); }, 3000);
    }

    // Inisialisasi saat halaman dimuat
    document.addEventListener('DOMContentLoaded', checkAuth);
  </script>
</body>
</html>

