      }
      .filter-selects-row {
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        gap: 10px !important;
        width: 100% !important;
      }

      /* Symmetrical Pills on Mobile */
      .category-pills {
        grid-template-columns: repeat(6, 1fr) !important;
      }
      .category-pills .pill-btn:nth-child(1),
      .category-pills .pill-btn:nth-child(2),
      .category-pills .pill-btn:nth-child(3),
      .category-pills .pill-btn:nth-child(4),
      .category-pills .pill-btn:nth-child(5),
      .category-pills .pill-btn:nth-child(6) {
