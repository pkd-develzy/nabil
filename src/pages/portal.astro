    @media (max-width: 480px) {
      .portal-wrap {
        padding: 16px 12px;
      }
      .card {
        padding: 16px 14px;
        border-radius: 16px;
      }
    }

    /* Utility & Layout Classes */
    .hidden {
      display: none !important;
    }
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
    }
    @media (min-width: 860px) {
      .grid-2 {
        grid-template-columns: 1.15fr 0.85fr;
      }
    }

    /* ==========================================================================
       RSVP & UCAPAN CARD GRID STYLES (MATCHING USER REFERENCE DESIGN)
       ========================================================================== */
    .rsvp-filter-container {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 22px;
    }
    .rsvp-search-box {
      position: relative;
      flex: 1 1 260px;
      max-width: 380px;
    }
    .rsvp-search-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      pointer-events: none;
    }
    .rsvp-search-input {
      width: 100%;
      background: #f8fafc;
      border: 1px solid rgba(201, 165, 107, 0.35);
      border-radius: 999px;
      padding: 9px 16px 9px 38px;
      font-size: 0.86rem;
      font-family: inherit;
      color: #1e293b;
      outline: none;
      transition: all 0.25s ease;
    }
    .rsvp-search-input:focus {
      background: #ffffff;
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(201, 165, 107, 0.25);
    }
    .rsvp-search-input::placeholder {
      color: #94a3b8;
    }
    .rsvp-filter-tabs {
      display: inline-flex;
      background: rgba(30, 4, 13, 0.55);
      padding: 4px;
      border-radius: 999px;
      border: 1.5px solid rgba(201, 165, 107, 0.35);
      gap: 4px;
      overflow-x: auto;
      max-width: 100%;
    }
    .rsvp-tab {
      background: transparent;
      border: none;
      color: var(--gold-soft);
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.82rem;
      font-family: inherit;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      transition: all 0.2s ease;
    }
    .rsvp-tab:hover {
      color: #ffffff;
      background: rgba(201, 165, 107, 0.15);
    }
    .rsvp-tab.active {
      background: #ffffff;
      color: #1e293b;
      font-weight: 600;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    }
    .rsvp-tab .tab-badge {
      font-size: 0.75rem;
      opacity: 0.85;
      font-weight: 500;
    }
    .rsvp-tab.active .tab-badge {
      color: #64748b;
    }

    /* Cards Grid */
    .rsvp-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
      gap: 18px;
    }
    @media (max-width: 640px) {
      .rsvp-cards-grid {
        grid-template-columns: 1fr;
        gap: 14px;
      }
    }
    .rsvp-card {
      background: #ffffff;
      color: #1e293b;
      border-radius: 18px;
      padding: 20px 20px 16px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
      border: 1px solid #edf0f5;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .rsvp-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }
    .rsvp-card-header {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .rsvp-avatar {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1.15rem;
      color: #ffffff;
      flex-shrink: 0;
      text-transform: uppercase;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }
    .rsvp-user-info {
      flex: 1;
      min-width: 0;
    }
    .rsvp-user-name-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }
    .rsvp-user-name {
      font-weight: 600;
      font-size: 0.98rem;
      color: #1e293b;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .rsvp-badge-att {
      font-size: 0.68rem;
      font-weight: 600;
      padding: 2px 7px;
      border-radius: 999px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .rsvp-badge-hadir {
      background: #ecfdf5;
      color: #059669;
      border: 1px solid #a7f3d0;
    }
    .rsvp-badge-berhalangan {
      background: #fef2f2;
      color: #dc2626;
      border: 1px solid #fecaca;
    }
    .rsvp-user-meta {
      font-size: 0.78rem;
      color: #8c96a3;
      margin-top: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .rsvp-card-body {
      margin: 14px 0 16px;
      font-size: 0.92rem;
      color: #334155;
      line-height: 1.58;
      flex-grow: 1;
      word-break: break-word;
      white-space: pre-wrap;
    }
    .rsvp-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 12px;
      border-top: 1px solid #f1f5f9;
      margin-top: auto;
    }

    /* Switch Toggle */
    .switch-wrap {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      user-select: none;
    }
    .switch-toggle {
      position: relative;
      display: inline-block;
      width: 42px;
      height: 24px;
      cursor: pointer;
      margin: 0;
    }
    .switch-toggle input {
      opacity: 0;
      width: 0;
      height: 0;
      position: absolute;
    }
    .switch-slider {
      position: absolute;
      inset: 0;
      background-color: #cbd5e1;
      transition: 0.25s ease;
      border-radius: 24px;
    }
    .switch-slider:before {
      position: absolute;
      content: "";
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background-color: white;
      transition: 0.25s ease;
      border-radius: 50%;
      box-shadow: 0 1px 4px rgba(0,0,0,0.2);
    }
    .switch-toggle input:checked + .switch-slider {
      background-color: #10b981;
    }
    .switch-toggle input:checked + .switch-slider:before {
      transform: translateX(18px);
    }
    .switch-label {
      font-size: 0.82rem;
      font-weight: 600;
      transition: color 0.2s ease;
    }
    .switch-label.is-active {
      color: #10b981;
    }
    .switch-label.is-hidden {
      color: #94a3b8;
    }

    /* Action Icon Buttons */
    .rsvp-card-actions {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .rsvp-icon-btn {
      background: transparent;
      border: none;
      color: #64748b;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
      padding: 0;
    }
    .rsvp-icon-btn:hover {
      background: #f1f5f9;
      color: #1e293b;
      transform: scale(1.08);
    }
    .rsvp-icon-btn.btn-act-wa:hover {
      background: #ecfdf5;
      color: #059669;
    }
    .rsvp-icon-btn.btn-act-dl:hover {
      background: #eff6ff;
      color: #2563eb;
    }
    .rsvp-icon-btn.btn-act-del:hover {
      background: #fef2f2;
      color: #ef4444;
    }
    .rsvp-empty-state {
      text-align: center;
      padding: 42px 20px;
      color: var(--gold-soft);
      grid-column: 1 / -1;
      background: rgba(30, 4, 13, 0.4);
      border-radius: 16px;
      border: 1px dashed rgba(201, 165, 107, 0.3);
    }
  </style>
</head>
<body>

  <!-- Floral Corner Accents -->
  <img src="/images/florals/frame/frame-tl.webp" class="flora-corner flora-tl" alt="" aria-hidden="true" />
  <img src="/images/florals/frame/frame-tl.webp" class="flora-corner flora-tr" alt="" aria-hidden="true" />
  <img src="/images/florals/frame/frame-tl.webp" class="flora-corner flora-bl" alt="" aria-hidden="true" />
  <img src="/images/florals/frame/frame-tl.webp" class="flora-corner flora-br" alt="" aria-hidden="true" />

  <!-- ================= LAYAR LOGIN ================= -->
  <div id="loginModal">
    <div class="card login-box">
      <div class="login-seal"><span>N&amp;I</span></div>
      <h2 style="font-size:1.45rem;margin-bottom:6px">Portal Pengantin</h2>
      <p style="font-size:0.86rem;color:var(--gold-soft);margin-bottom:24px">
        Ahmad Nabil Kholili &amp; Fadilatul Izza
      </p>

      <form id="loginForm" onsubmit="return handleLogin(event)">
        <div class="form-group" style="text-align:left">
          <label class="form-label" for="loginPass">Kata Sandi Acara</label>
          <div style="position:relative">
            <input type="password" id="loginPass" class="form-input" placeholder="Masukkan kata sandi..." required autofocus style="padding-right:46px" />
            <button type="button" id="togglePassBtn" onclick="togglePasswordVisibility()" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--gold-soft);cursor:pointer;padding:6px;display:flex;align-items:center;justify-content:center;opacity:0.85;transition:opacity 0.2s" aria-label="Tampilkan / sembunyikan kata sandi" title="Tampilkan / sembunyikan kata sandi">
              <svg id="eyeOpen" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg id="eyeClosed" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
          <div id="loginError" style="color:#ff859d;font-size:0.8rem;margin-top:6px;display:none">
            Kata sandi salah. Silakan coba kembali.
          </div>
        </div>
        <button type="submit" class="btn" style="width:100%;margin-top:10px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          Masuk ke Portal
        </button>
      </form>
    </div>
  </div>

  <!-- ================= DASHBOARD PORTAL ================= -->
  <div class="portal-wrap hidden" id="portalContent">
    
    <!-- Top Bar -->
    <header class="portal-header">
      <div class="portal-brand">
        <div class="portal-seal"><span>N&amp;I</span></div>
        <div class="portal-brand-text">
          <h1>Portal Kirim Undangan</h1>
          <p>Nabil &amp; Izza &bull; Kamis, 21 Januari 2027</p>
        </div>
      </div>
      <div class="portal-header-actions">
        <a href="#sectionRsvps" class="btn btn-outline btn-sm">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Lihat RSVP
        </a>
        <a href="/" target="_blank" class="btn btn-outline btn-sm">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          Lihat Undangan
        </a>
        <button type="button" onclick="handleLogout()" class="btn btn-outline btn-sm" style="border-color:rgba(201,165,107,0.3)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Keluar
        </button>
      </div>
    </header>

    <!-- Ringkasan Statistik -->
    <div class="stats-grid">
      <div class="stat-box">
        <div class="stat-number" id="statTotal">0</div>
        <div class="stat-label">Total Tamu</div>
      </div>
      <div class="stat-box">
        <div class="stat-number" id="statSent" style="color:#62ebb0">0</div>
        <div class="stat-label">Sudah Dikirim</div>
      </div>
      <div class="stat-box">
        <div class="stat-number" id="statRsvpHadir" style="color:#ffd98a">0 Org</div>
        <div class="stat-label">RSVP Hadir (Pax)</div>
      </div>
      <div class="stat-box">
        <div class="stat-number" id="statRsvpTotal" style="color:#ffb870">0</div>
        <div class="stat-label">Total Doa &amp; RSVP</div>
      </div>
    </div>

    <!-- Main Grid: Form Pembuatan & Preview Pesan -->
    <div class="grid-2">
      <!-- Sisi Kiri: Form Input Tamu -->
      <div class="card">
        <h2 style="font-size:1.15rem;margin-bottom:18px;display:flex;align-items:center;gap:8px">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
          1. Tambah Data Tamu
        </h2>

        <div class="form-group">
          <label class="form-label" for="guestName">Nama Tamu Undangan *</label>
          <input type="text" id="guestName" class="form-input" placeholder="Contoh: Bpk. H. Ahmad Fauzi &amp; Istri" oninput="updateMessagePreview()" />
        </div>

        <div class="form-group">
          <label class="form-label" for="guestPhone">Nomor WhatsApp Tamu</label>
          <input type="tel" id="guestPhone" class="form-input" placeholder="Contoh: 08123456789 atau 6281234..." oninput="updateMessagePreview()" />
          <small style="color:rgba(242,224,190,0.65);font-size:0.75rem;margin-top:4px;display:block">
            Bisa format 08... atau 628... (otomatis disesuaikan untuk link WhatsApp).
          </small>
        </div>

        <div class="form-group">
          <label class="form-label">Kategori Tamu</label>
          <div class="pill-group category-pills" id="categoryGroup">
            <button type="button" class="pill-btn active" data-cat="Umum" onclick="selectCategory(this)">Umum</button>
            <button type="button" class="pill-btn" data-cat="Keluarga" onclick="selectCategory(this)">Keluarga</button>
            <button type="button" class="pill-btn" data-cat="VIP" onclick="selectCategory(this)">VIP</button>
            <button type="button" class="pill-btn" data-cat="Sahabat" onclick="selectCategory(this)">Sahabat</button>
            <button type="button" class="pill-btn" data-cat="Teman Pondok" onclick="selectCategory(this)">Teman Pondok</button>
            <button type="button" class="pill-btn" data-cat="Grup WA" onclick="selectCategory(this)">👥 Grup WA</button>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Gaya Bahasa Template Pesan</label>
