          ? '<span class="rsvp-badge-att rsvp-badge-hadir">Hadir (' + (r.pax || 1) + 'p)</span>'
          : '<span class="rsvp-badge-att rsvp-badge-berhalangan">Berhalangan</span>';

        var messageText = r.message ? escapeHtml(r.message) : '<em style="color:rgba(242,224,190,0.45);font-size:0.85rem">Tidak menyertakan ucapan tertulis</em>';

        html += '<article class="rsvp-card" id="rsvp-card-' + r.id + '">' +
          // Header: Avatar + User Info + Attendance Badge
