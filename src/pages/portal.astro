      font-size: 1.08rem;
      font-style: italic;
      color: var(--ivory);
      line-height: 1.6;
      flex-grow: 1;
      word-break: break-word;
      white-space: pre-wrap;
      background: rgba(14, 2, 7, 0.4);
      border-left: 2.5px solid var(--gold);
      padding: 10px 14px;
      border-radius: 0 12px 12px 0;
