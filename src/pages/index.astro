/* ---------- MUSIC (AUDIO FILE & MAQAM HIJAZ SYNTHESIZER FALLBACK) ---------- */
var Music=(function(){
  var ctx,master,verb,timer,next=0,beat=0,bar=0,playing=false,audioEl=null,started=false;
  var SC=[-12,-11,-8,-7,-5,-4,-2,0,1,4,5,7,8,10,12];
