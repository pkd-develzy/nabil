---
// Undangan Pernikahan Digital Ahmad Nabil Kholili & Fadilatul Izza (Tema Royal Burgundy & Gold)
// Halaman ini hanya merangkai komponen. Markup ada di src/components, CSS di src/styles, JS di src/scripts.
import '../styles/main.css';
import Screen403 from '../components/Screen403.astro';
import Cover from '../components/Cover.astro';
import Hero from '../components/sections/Hero.astro';
import Ayat from '../components/sections/Ayat.astro';
import Salam from '../components/sections/Salam.astro';
import Mempelai from '../components/sections/Mempelai.astro';
import Acara from '../components/sections/Acara.astro';
import Lokasi from '../components/sections/Lokasi.astro';
import Hadiah from '../components/sections/Hadiah.astro';
import Rsvp from '../components/sections/Rsvp.astro';
import Ucapan from '../components/sections/Ucapan.astro';
import Penutup from '../components/sections/Penutup.astro';
import Credit from '../components/sections/Credit.astro';
import FloatingNav from '../components/FloatingNav.astro';
import configJs from '../scripts/config.js?raw';
import configLoaderJs from '../scripts/config-loader.js?raw';
import js00 from '../scripts/app/00-helpers.js?raw';
import js01 from '../scripts/app/01-binding.js?raw';
import js02 from '../scripts/app/02-decor.js?raw';
import js03 from '../scripts/app/03-motion.js?raw';
import js04 from '../scripts/app/04-countdown.js?raw';
import js05 from '../scripts/app/05-clipboard.js?raw';
import js06 from '../scripts/app/06-rsvp.js?raw';
import js07 from '../scripts/app/07-music.js?raw';
import js08 from '../scripts/app/08-cover.js?raw';
import js09 from '../scripts/app/09-navbar.js?raw';
import js10 from '../scripts/app/10-wishes.js?raw';
// Semua file di src/scripts/app berbagi satu scope (IIFE) seperti sebelum dipecah; urutannya penting.
const appJs = "(function(){\n'use strict';\n" + [js00, js01, js02, js03, js04, js05, js06, js07, js08, js09, js10].join('') + "})();";
---
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Undangan Pernikahan Nabil &amp; Izza</title>
<meta name="description" content="Undangan walimatul 'urs Ahmad Nabil Kholili dan Fadilatul Izza, Kamis 21 Januari 2027.">
<meta name="theme-color" content="#3a0916">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="alternate icon" type="image/x-icon" href="/favicon.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Aref+Ruqaa:wght@400;700&family=Cinzel+Decorative:wght@700;900&family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/fonts-wedding.css">
<script is:inline>
if ('scrollRestoration' in history) {
  history.scrollRestoration = 'manual';
}
window.scrollTo(0, 0);
document.documentElement.scrollTop = 0;
document.body.scrollTop = 0;
document.documentElement.classList.add('js','locked');
if(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.style.setProperty('--k','.2');document.documentElement.classList.add('rm');}
</script>
<noscript><style is:global>#cover{display:none!important}html.locked{overflow:auto}</style></noscript>
</head>
<body>

<Screen403 />

<!-- Scroll Progress Bar -->
<div class="scroll-progress-bar" id="scrollProgress" aria-hidden="true"></div>

<!-- ===== shared SVG defs (gradients & rose rings) ===== -->
<svg class="defs" aria-hidden="true" focusable="false" id="defs"></svg>

<Cover />

<div class="petals" id="petals" aria-hidden="true"></div>
<button class="music" id="music" type="button" aria-pressed="false" aria-label="Musik latar">
  <svg class="on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M 21.0 8.4 A 9.8 9.8 0 1 1 17.4 3.9"></path>
    <path d="M 4.4 12 A 7.6 7.6 0 0 1 12 4.4"></path>
    <path d="M 19.6 12 A 7.6 7.6 0 0 1 12 19.6"></path>
    <circle cx="12" cy="12" r="3.6"></circle>
    <circle cx="12" cy="12" r="1.2"></circle>
    <circle cx="17.7" cy="7.8" r="1.4"></circle>
    <path d="M 19.1 7.8 V 2.4 L 21.8 4.9"></path>
  </svg>
  <svg class="off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M 21.0 8.4 A 9.8 9.8 0 1 1 17.4 3.9"></path>
    <path d="M 4.4 12 A 7.6 7.6 0 0 1 12 4.4"></path>
    <path d="M 19.6 12 A 7.6 7.6 0 0 1 12 19.6"></path>
    <circle cx="12" cy="12" r="3.6"></circle>
    <circle cx="12" cy="12" r="1.2"></circle>
    <circle cx="17.7" cy="7.8" r="1.4"></circle>
    <path d="M 19.1 7.8 V 2.4 L 21.8 4.9"></path>
    <line x1="2" y1="2" x2="22" y2="22" stroke="currentColor" stroke-width="1.8"></line>
  </svg>
</button>

<!-- ===================== HALAMAN UNDANGAN ===================== -->
<main id="page" tabindex="-1">

<Hero />

<Ayat />

<Salam />

<Mempelai />

<Acara />

<Lokasi />

<Hadiah />

<Rsvp />

<Ucapan />

<Penutup />

<Credit />

<FloatingNav />

</main>

<!-- ============ CONFIG: Default configuration (bisa diatur penuh dari dashboard) ============ -->
<script is:inline set:html={configJs}></script>

<!-- ============ Supabase Client & Configuration Loader ============ -->
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script is:inline src="/supabase-config.js"></script>
<script is:inline set:html={configLoaderJs}></script>

<!-- ============ Universal Template Scripts: Animations, Bindings, Audio, Envelope & Carousel ============ -->
<script is:inline set:html={appJs}></script>
<script is:inline src="/js/azluna-auto-scroll.js"></script>
<script is:inline src="/js/azluna-3d-motion.js"></script>
<script is:inline src="/js/azluna-wind.js"></script>
</body>
</html>
