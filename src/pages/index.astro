/* ================= TEXT LEGIBILITY (WAJIB TERBACA DI SEMUA BROWSER) =================
   Teks emas gradien (background-clip:text + color:transparent) menghilang di Safari iOS
   dan beberapa browser Android saat dikombinasikan dengan animasi/transform/filter.
   Ganti dengan warna solid + glow, dan perkuat kontras label-label tipis. */
.title,.salam-lt,.pname,.ev h3,.loc h3,.dress h3,.c-names,.name{
  background:none!important;-webkit-background-clip:border-box!important;background-clip:border-box!important;
  -webkit-text-fill-color:currentColor!important;filter:none!important;
}
.title,.salam-lt,.pname,.ev h3,.loc h3,.dress h3{
  color:#f3dcaa!important;
  text-shadow:0 1px 2px rgba(20,3,8,.85),0 0 18px rgba(20,3,8,.55),0 0 22px rgba(201,165,107,.28)!important;
}
.light .title,.light .salam-lt,.light .dress h3{
  color:#6a1129!important;
  text-shadow:0 1px 0 rgba(255,250,240,.9),0 0 14px rgba(255,248,236,.95),0 0 26px rgba(255,248,236,.8)!important;
}
.c-names,.name{
  color:#f6e0b0!important;
  text-shadow:0 2px 3px rgba(20,3,8,.85),0 0 22px rgba(20,3,8,.6),0 0 30px rgba(201,165,107,.35)!important;
}
/* Label & teks kecil di bagian gelap: lebih terang + bayangan agar terbaca di atas bunga */
.dark .eyebrow,.darker .eyebrow,.dark .eyebrow-ar,.darker .eyebrow-ar,.hero .eyebrow-ar,
.cue small,.pre-title,.amp,.amp-big,.paddr,.pdesc,.pdesc b,.fam,.fam small,.fam span,.dark .sub,.darker .sub,.dark .lead,.darker .lead,.doa{
  color:#f6e3bb!important;
  text-shadow:0 1px 2px rgba(20,3,8,.9),0 0 12px rgba(20,3,8,.75),0 0 24px rgba(20,3,8,.45)!important;
}
.paddr,.pdesc{color:#f1e2cc!important}
.amp-big{filter:none!important}
/* Label di bagian terang: lebih gelap + halo krem agar terbaca di atas bunga */
.light .eyebrow,.light .eyebrow-ar{color:#7a4a17!important}
.light .eyebrow,.light .eyebrow-ar,.light .lead,.light .sub,.light .salam-ar{
  text-shadow:0 0 10px rgba(255,250,240,.95),0 0 20px rgba(255,248,236,.85)!important;
}
.light .lead,.light .sub{color:#4a0d1d!important}
.credit,.credit span{color:rgba(240,224,192,.9)!important}
.credit b{color:#f0d9a8!important}

/* ================= FLORAL KLIEN: WREATH, BOUQUET & LATAR KARTU ================= */
/* Rangkaian bouquet (elegant-vintage-floral-arrangement...svg) */
.dress-bouquet{display:block;width:min(74vw,340px);height:auto;margin:0 auto 6px;filter:drop-shadow(0 8px 16px rgba(58,9,22,.25))}
.fam-bouquet{display:block;width:min(80vw,380px);height:auto;margin:1.8rem auto -10px;filter:drop-shadow(0 8px 20px rgba(0,0,0,.45))}
/* Latar kartu: 279747897_...svg (gelombang burgundy) + lapisan gelap agar teks tetap kontras */
.ev>.card-bg,.bank>.card-bg,.wish-env-card>.card-bg,.cd div{
  background:
    linear-gradient(165deg,rgba(92,18,40,.62) 0%,rgba(46,8,20,.74) 60%,rgba(26,4,11,.86) 100%),
    url('/images/florals/279747897_01eb49de-6803-4640-a406-d63ba2d0e9e0.svg') center/cover no-repeat,
    var(--wine-900)!important;
}
.cd div{background-size:auto,300% auto,auto!important}

/* Kartu: latar dipindah ke .card-bg agar rangkaian bunga benar-benar berada DI BELAKANG kartu
   (kartu membuat stacking context sendiri, jadi z-index:-1 saja tetap tampil di atas latar kartu) */
.ev,.bank,.form,.ayat,.wish-env-card{isolation:isolate;background:transparent!important}
.card-bg{position:absolute;inset:0;border-radius:inherit;z-index:-1;pointer-events:none}
.form>.card-bg{background:#fffaf1}
.ayat>.card-bg{background:linear-gradient(180deg,#fffdf8,#f7efe0)}
.card-flora-cluster{z-index:-2!important}

/* Lapisan dekorasi kartu tidak boleh ikut aturan umum seperti .ev>*{position:relative} */
.card-bg{position:absolute!important;inset:0!important;z-index:-1!important}
.card-crown{position:absolute!important;z-index:4!important}
.card-flora-cluster{position:absolute!important}
/* Penutup: beri ruang di bawah agar bunga sudut tidak menimpa nama keluarga */
#penutup{padding-top:clamp(170px,50vw,300px);padding-bottom:clamp(200px,58vw,340px)}
#penutup .fam{position:relative;z-index:6;padding:14px 18px;border-radius:18px;background:radial-gradient(ellipse at 50% 50%,rgba(26,4,11,.72) 0%,rgba(26,4,11,.45) 60%,rgba(26,4,11,0) 100%)}

/* ======================= MOTION SYSTEM =======================
   1) Bunga: digerakkan oleh /js/azluna-wind.js (angin hidup). Animasi CSS lama dimatikan
      agar tidak bertabrakan; pangkal batang (transform-origin) ditentukan di sini.
   2) Komponen: setiap komponen punya gerak masuk sendiri (data-m) memakai properti
      translate/scale/rotate terpisah, sehingga bisa digabung dengan animasi idle (transform). */
.gl-img,.card-flora-img,.card-crown,.arch-swag{animation:none!important}
.dress-bouquet,.fam-bouquet{transform-origin:50% 100%}
.gl.tl .gl-img{transform-origin:0 0}
.gl.tr .gl-img{transform-origin:100% 0}

/* --- Gerak masuk per komponen --- */
html.js .rv[data-m]{
  transform:none;filter:none;
  transition:opacity 1.1s cubic-bezier(.2,.8,.2,1),translate 1.25s cubic-bezier(.16,.84,.2,1),scale 1.25s cubic-bezier(.16,.84,.2,1),rotate 1.3s cubic-bezier(.16,.84,.2,1),filter 1.1s ease,clip-path 1.4s cubic-bezier(.65,0,.2,1);
  transition-delay:var(--d,0s);
}
html.js .rv[data-m="rise"]{translate:0 56px}
html.js .rv[data-m="drop"]{translate:0 -42px}
html.js .rv[data-m="left"]{translate:-80px 0;rotate:-2.5deg}
html.js .rv[data-m="right"]{translate:80px 0;rotate:2.5deg}
html.js .rv[data-m="zoom"]{scale:.82}
html.js .rv[data-m="pop"]{scale:.4;transition-timing-function:ease,ease,cubic-bezier(.34,1.7,.5,1),cubic-bezier(.34,1.6,.5,1),ease,ease}
html.js .rv[data-m="spin"]{scale:.3;rotate:-160deg;transition-timing-function:ease,ease,cubic-bezier(.34,1.5,.5,1),cubic-bezier(.22,1.2,.36,1),ease,ease}
html.js .rv[data-m="blur"]{filter:blur(12px);scale:1.08}
html.js .rv[data-m="spread"]{scale:.62 1;filter:blur(6px)}
html.js .rv[data-m="flip"]{rotate:x 75deg;translate:0 30px;transform-origin:50% 0}
html.js .rv[data-m="unfold"]{rotate:y -38deg;translate:50px 0;transform-origin:0 50%}
html.js .rv[data-m="swing"]{rotate:-9deg;transform-origin:50% 0;translate:0 -20px}
html.js .rv[data-m="curtain"]{scale:0 1;transform-origin:50% 50%}
html.js .rv[data-m="wipe"]{scale:0 1;transform-origin:0 50%}
html.js .rv[data-m].in{opacity:1;translate:0 0;scale:1;rotate:0deg;filter:none}

/* --- Gerak idle (terus hidup setelah muncul) --- */
@keyframes idleFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
@keyframes idleBob{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-4px) rotate(4deg)}}
@keyframes idleTilt{0%,100%{transform:rotate(-.6deg)}50%{transform:rotate(.6deg)}}
@keyframes idleGlow{0%,100%{box-shadow:0 0 0 rgba(201,165,107,0)}50%{box-shadow:0 0 22px rgba(201,165,107,.45)}}
@keyframes idleBreath{0%,100%{scale:1}50%{scale:1.06}}
.ev{animation:idleFloat 7s ease-in-out infinite}
.ev:nth-child(2){animation-duration:8.2s;animation-delay:-2.5s}
.bank{animation:idleFloat 6.4s ease-in-out infinite}
.bank:nth-child(2){animation-delay:-3.1s}
.ayat{animation:idleFloat 9s ease-in-out infinite}
.form{animation:idleFloat 10s ease-in-out infinite}
.wish-carousel-wrap{animation:idleTilt 11s ease-in-out infinite}
.loc .mapframe{animation:idleFloat 8s ease-in-out infinite}
.loc:nth-child(2) .mapframe{animation-delay:-4s}
.sw i{animation:idleBob 3.6s ease-in-out infinite}
.sw i:nth-child(2){animation-delay:-.9s}.sw i:nth-child(3){animation-delay:-1.8s}.sw i:nth-child(4){animation-delay:-2.7s}
.mono{animation:idleBreath 4.5s ease-in-out infinite}
.amp-big{animation:idleBreath 5s ease-in-out infinite}
.loc .btn,.bank .btn{animation:idleGlow 3.8s ease-in-out infinite}
.sec:not(.hero) .eyebrow-ar{animation:idleFloat 6s ease-in-out infinite}
html.rm .ev,html.rm .bank,html.rm .ayat,html.rm .form,html.rm .wish-carousel-wrap,html.rm .mapframe,html.rm .sw i,html.rm .mono,html.rm .amp-big,html.rm .btn,html.rm .eyebrow-ar{animation:none!important}
</style>
