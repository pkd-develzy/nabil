/* ---------- OPEN 3D LUXURY ENVELOPE ---------- */
var cover=$('#cover'),env=$('#env'),page=$('#page'),shiftEl=$('#envShift'),skipBtn=$('#skip'),opened=false,pulled=false,timers=[];
function at(ms,fn){timers.push(setTimeout(fn,ms*K))}
function up(s){var p=$(s);if(p){p.classList.remove('down');p.classList.add('up')}}
function down(s){var p=$(s);if(p){p.classList.remove('up');p.classList.add('down')}}
function pull(){
  if(pulled)return;pulled=true;
  timers.forEach(clearTimeout);timers=[];
  if($('#music')) $('#music').classList.add('show');
  if(cover) cover.classList.add('pulling');
  html.classList.add('pulling');
  setTimeout(function(){html.classList.add('revealed')},420*K);
  setTimeout(function(){
    if(cover) cover.style.display='none';
    html.classList.remove('locked');
    window.scrollTo(0,0);
    try{page.focus({preventScroll:true})}catch(e){}
  },2600*K);
}
function open(){
  if(opened)return;opened=true;
  if(!(CONFIG.visibility&&CONFIG.visibility.music===false)){try{Music.start()}catch(e){}}
  if($('#music')) $('#music').classList.add('show');
  if(cover) cover.classList.add('playing','seal-hide');
  var r=env.getBoundingClientRect(),h=r.height;
  var targetTop=Math.max(h*.95,(innerHeight-h*.12)/2);
  var shift=Math.max(0,Math.min(targetTop-r.top,innerHeight-r.bottom-14));
  if(shiftEl) shiftEl.style.setProperty('--shift',shift.toFixed(0)+'px');
  at(250,function(){if(cover) cover.classList.add('flap-open')});
  at(950,function(){up('.p1')});
  at(3600,function(){down('.p1')});
  at(4200,function(){up('.p2')});
  at(6900,function(){down('.p2')});
  at(7500,function(){up('.p3')});
  at(10200,function(){down('.p3')});
  at(11000,pull);
}
if(env) {
  env.addEventListener('click',open);
  env.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '||e.key==='Spacebar'){e.preventDefault();open()}});
}
if(skipBtn) skipBtn.addEventListener('click',function(e){e.stopPropagation();pull()});

