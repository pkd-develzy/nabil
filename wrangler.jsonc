{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nabil-izza-wedding",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nabil-izza-db",
      "database_id": "7f43b3b7-3830-46d3-8c0a-023023e7f876"
    }
  ]
}

