# Global CORS & Security
/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# Immutable Static Assets (Images, WebP, Fonts, Audio, CSS, JS) - 1 Year Cache
/images/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/music/*
  Cache-Control: public, max-age=31536000, immutable
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
*.webp
  Cache-Control: public, max-age=31536000, immutable
*.mp3
  Cache-Control: public, max-age=31536000, immutable
*.ttf
  Cache-Control: public, max-age=31536000, immutable
*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML Pages - Fast Revalidation (304 Not Modified when unchanged)
/
  Cache-Control: public, max-age=0, must-revalidate
/portal
  Cache-Control: public, max-age=0, must-revalidate
/portal/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Dynamic API Endpoints - No Cache
/api/*
  Cache-Control: no-store, no-cache, must-revalidate
